# Copie pra .env.local (local) ou configure em Vercel > Project > Settings > Environment Variables (produção).
# Nunca commitar os valores reais.

# Conta Google que envia os emails com o código (precisa de verificação em 2 etapas
# + senha de app: https://myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# String em base64 do JSON da chave de conta de serviço do Firebase (evita
# problemas de formatação com as quebras de linha da private_key).
# Gerar com: [Convert]::ToBase64String([IO.File]::ReadAllBytes("caminho\do\arquivo.json"))
# Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada.
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=
