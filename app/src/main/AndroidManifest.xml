<?xml version="1.0" encoding="utf-8"?>

<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:name=".EcoCienteApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EcoCiente">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification_ecociente" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/verde_escuro_principal" />

        <service
            android:name=".notifications.EcoCienteFirebaseMessagingService"
            android:exported="false">

            <intent-filter>
                <action
                    android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

        <activity
            android:name=".views.MainActivity"
            android:exported="false" />

        <activity
            android:name=".views.SindicoHomeActivity"
            android:exported="false" />

        <activity
            android:name=".views.SindicoCooperativasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.SindicoSolicitacaoColetaActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.Dialogo"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.SindicoInformacoesCooperativaActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.Dialogo" />

        <activity
            android:name=".views.SindicoHistoricoActivity"
            android:exported="false" />

        <activity
            android:name=".views.SindicoUnidadesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.SindicoRankingActivity"
            android:exported="false" />

        <activity
            android:name=".views.SindicoDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".views.SindicoValidacaoActivity"
            android:exported="false" />

        <activity
            android:name=".views.CooperativaHomeActivity"
            android:exported="false" />

        <activity
            android:name=".views.MensagensActivity"
            android:exported="false" />

        <receiver
            android:name=".repository.LembretesColeta$Receptor"
            android:exported="false" />

        <activity
            android:name=".views.AvisoDetalheActivity"
            android:exported="false" />

        <activity
            android:name=".views.BibliotecaActivity"
            android:exported="false" />
        <!-- Fluxo de educacao: curso > introducao > leitura > celebracao. -->
        <activity android:name=".views.CursoEducativoActivity"
            android:exported="false" />
        <activity android:name=".views.InicioConteudoEducativoActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.QuizIntro" />
        <activity android:name=".views.LeituraEducativaActivity"
            android:exported="false" />
        <activity android:name=".views.ConclusaoEducativaActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.QuizIntro" />
        <activity
            android:name=".views.TelaListaActivity"
            android:exported="false" />

        <activity
            android:name=".views.FeedActivity"
            android:exported="false" />

        <activity
            android:name=".views.RegistroDescarteActivity"
            android:exported="false" />

        <activity
            android:name=".views.DetalheItemActivity"
            android:exported="false" />

        <activity
            android:name=".views.StatusDescarteActivity"
            android:exported="false" />

        <activity
            android:name=".views.SolicitacoesActivity"
            android:exported="false" />

        <activity
            android:name=".views.ConversaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.CentralNotificacoesActivity"
            android:exported="false" />

        <activity
            android:name=".views.SolicitacaoDetalheActivity"
            android:exported="false" />

        <activity
            android:name=".views.CondominioHomeActivity"
            android:exported="false" />

        <activity
            android:name=".views.CalendarioColetasActivity"
            android:exported="false" />

        <activity
            android:name=".views.QuizActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.Quiz" />

        <activity
            android:name=".views.InicioQuizActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.QuizIntro" />

        <activity
            android:name=".views.QuizPerguntasActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.Quiz" />

        <activity
            android:name=".views.QuizResultadoActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.Quiz" />

        <activity
            android:name=".views.QuizRevisaoActivity"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.Quiz" />

        <activity
            android:name=".views.ChatActivity"
            android:theme="@style/Theme.EcoCiente.Verde"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.GerenciarPerfilActivity"
            android:exported="false" />

        <activity
            android:name=".views.InformacoesPessoaisActivity"
            android:exported="false" />

        <activity
            android:name=".views.GerenciarSenhaActivity"
            android:exported="false" />

        <activity
            android:name=".views.NotificacoesActivity"
            android:exported="false" />

        <activity
            android:name=".views.Login"
            android:theme="@style/Theme.EcoCiente.Verde"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.EsqueciSenha"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.Dialogo"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".views.SelecaoPerfil"
            android:exported="false"
            android:theme="@style/Theme.EcoCiente.Dialogo" />

        <activity
            android:name=".views.SplashScreen"
            android:theme="@style/Theme.EcoCiente.Splash"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">

            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />

        </provider>

        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="@string/facebook_app_id" />

        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="@string/facebook_client_token" />

        <activity
            android:name="com.facebook.FacebookActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation"
            android:exported="false" />

        <activity
            android:name="com.facebook.CustomTabActivity"
            android:exported="true">

            <intent-filter>

                <action
                    android:name="android.intent.action.VIEW" />

                <category
                    android:name="android.intent.category.DEFAULT" />

                <category
                    android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="@string/fb_login_protocol_scheme" />

            </intent-filter>

        </activity>

    </application>

</manifest>