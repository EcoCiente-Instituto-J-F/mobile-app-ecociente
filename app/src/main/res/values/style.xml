<?xml version="1.0" encoding="utf-8"?>

<resources>
    <style name="TextoCampoNunitoMedium">
        <item name="android:fontFamily">@font/nunito_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/cinza_escuro_textos</item>
    </style>

    <style name="ShapeAppearance.EcoCiente.PainelInferior" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="DivisorCampoPessoal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@color/cinza_borda_card_perfil</item>
    </style>
</resources>