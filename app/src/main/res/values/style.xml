<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="ShapeAppearance.EcoCiente.PainelInferior" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="DivisorCampoPessoal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@color/cinza_borda_card_perfil</item>
    </style>

    <style name="RotuloDetalheSolicitacao">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:textColor">@color/cinza_texto_auxiliar</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ValorDetalheSolicitacao">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:fontFamily">@font/nunito_semibold</item>
        <item name="android:textColor">@color/verde_escuro_principal</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="AbaMensagens">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textColor">@color/verde_escuro_principal</item>
        <item name="android:textSize">13sp</item>
    </style>


    <style name="ChipCategoriaAviso">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fundo_chip_aviso</item>
        <item name="android:fontFamily">@font/nunito_bold</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>
