<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="35dp">

        <TextView
            android:id="@+id/tituloLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/login"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="25sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerEmail"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="34dp"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tituloLogin"
            app:strokeColor="@color/verde_escuro_principal"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:id="@+id/iconeEmail"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/icone_email"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_email" />

                <EditText
                    android:id="@+id/campoEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="emailAddress"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/nunito_medium"
                    android:hint="@string/hint_email"
                    android:imeOptions="actionNext"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:textColor="@color/verde_escuro_principal"
                    android:textColorHint="@color/cinza_escuro_textos"
                    android:textSize="16sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/erroEmailLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_medium"
            android:textColor="@color/rosa_ecociente"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerEmail" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerSenha"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/erroEmailLogin"
            app:strokeColor="@color/verde_escuro_principal"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/iconeOlhoSenha"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iconeSenha"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@string/icone_senha"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_senha" />

                    <EditText
                        android:id="@+id/campoSenha"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="password"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/nunito_medium"
                        android:hint="@string/senha"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:padding="0dp"
                        android:textColor="@color/verde_escuro_principal"
                        android:textColorHint="@color/cinza_escuro_textos"
                        android:textSize="16sp" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/iconeOlhoSenha"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/mostrar_senha"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_olho_fechado" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/erroSenhaLogin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_medium"
            android:textColor="@color/rosa_ecociente"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerSenha" />

        <TextView
            android:id="@+id/textoEsqueceuSenha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/nunito_medium"
            android:text="@string/esqueceu_senha"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/erroSenhaLogin" />

        <FrameLayout
            android:id="@+id/containerBotaoLogin"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="38dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoEsqueceuSenha">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoLogin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/login"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="17sp"
                app:backgroundTint="@color/verde_escuro_principal"
                app:cornerRadius="12dp"
                app:elevation="0dp" />

            <ProgressBar
                android:id="@+id/indicadorCarregamentoLogin"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/branco"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/divisorOu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerBotaoLogin">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/cinza_divisor_login" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/nunito_medium"
                android:text="@string/separador_ou"
                android:textColor="@color/cinza_escuro_textos"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/cinza_divisor_login" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoGoogle"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/continuar_com_google"
            android:textAllCaps="false"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="13sp"
            app:backgroundTint="@color/branco"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:icon="@drawable/icon_google"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="20dp"
            app:iconTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divisorOu"
            app:strokeColor="@color/cinza_divisor_login"
            app:strokeWidth="1dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoFacebook"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/continuar_com_facebook"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="13sp"
            app:backgroundTint="@color/azul_facebook"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:icon="@drawable/icon_facebook"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconSize="20dp"
            app:iconTint="@color/branco"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botaoGoogle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>