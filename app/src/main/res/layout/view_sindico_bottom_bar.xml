<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="86dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/sindico_nav_fundo"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/sindicoNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Home do síndico">
            <View
                android:id="@+id/sindicoNavIndicadorHome"
                android:layout_width="27dp"
                android:layout_height="4dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/sindico_nav_indicador" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/sindicoNavIconeHome"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sindico_nav_home" />
                <TextView
                    android:id="@+id/sindicoNavTextoHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/nunito_bold"
                    android:text="Home"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/sindicoNavSolicitacao"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Abrir solicitações de coleta">
            <View
                android:id="@+id/sindicoNavIndicadorSolicitacao"
                android:layout_width="27dp"
                android:layout_height="4dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/sindico_nav_indicador" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/sindicoNavIconeSolicitacao"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sindico_nav_solicitacao" />
                <TextView
                    android:id="@+id/sindicoNavTextoSolicitacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="Solicitação"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/sindicoNavHistorico"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Abrir histórico de coletas">
            <View
                android:id="@+id/sindicoNavIndicadorHistorico"
                android:layout_width="27dp"
                android:layout_height="4dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/sindico_nav_indicador" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/sindicoNavIconeHistorico"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sindico_nav_historico" />
                <TextView
                    android:id="@+id/sindicoNavTextoHistorico"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="Histórico"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/sindicoNavUnidades"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="Abrir dados do condomínio">
            <View
                android:id="@+id/sindicoNavIndicadorUnidades"
                android:layout_width="27dp"
                android:layout_height="4dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/sindico_nav_indicador" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/sindicoNavIconeUnidades"
                    android:layout_width="27dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:src="@drawable/sindico_nav_unidades" />
                <TextView
                    android:id="@+id/sindicoNavTextoUnidades"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="Unidades"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/sindico_nav_mascote_fundo"
        android:contentDescription="Eko indisponível nesta demonstração">
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/sindico_nav_eko" />
    </FrameLayout>
</FrameLayout>
