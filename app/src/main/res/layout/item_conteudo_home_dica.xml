<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="#FAFAFA"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/cinza_borda_clara_home"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="9dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="102dp">

            <ImageView
                android:id="@+id/imagemConteudoDica"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:contentDescription="@string/imagem_dica"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/img_greenplastic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:background="@drawable/fundo_selo_conteudo_home"
                android:fontFamily="@font/nunito_bold"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="@string/dica"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="11sp" />

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_bold"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:text="@string/titulo_dica_home"
            android:textColor="@color/preto_texto_home"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/tempo_leitura"
                android:scaleType="centerInside"
                android:src="@drawable/ic_relogio" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/tres_minutos_leitura"
                android:textColor="@color/cinza_secundario_home"
                android:textSize="11.5sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
