<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginTop="12dp"
    android:layout_marginEnd="18dp"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/branco"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cinza_borda_home"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/abaCentralNotificacoes"
            style="@style/AbaMensagens"
            android:text="@string/notificacoes" />

        <TextView
            android:id="@+id/abaCentralAvisos"
            style="@style/AbaMensagens"
            android:text="@string/avisos" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
