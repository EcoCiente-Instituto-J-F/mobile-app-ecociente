<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/raizCursoEducativo" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/branco">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="20dp">
        <ImageView android:id="@+id/voltarCursoEducativo" android:layout_width="46dp" android:layout_height="46dp" android:padding="12dp" android:src="@drawable/ic_voltar" android:contentDescription="Voltar" app:tint="@color/verde_escuro_principal"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Minha trilha de aprendizado" android:fontFamily="@font/nunito_bold" android:textColor="@color/verde_escuro_principal" android:textSize="17sp"/>
        <View android:layout_width="46dp" android:layout_height="1dp"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/scrollCursoEducativo" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="10dp" android:paddingEnd="20dp" android:paddingBottom="28dp">

            <com.google.android.material.card.MaterialCardView android:id="@+id/cartaoCapaCursoEducativo" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/verde_fundo_card_claro" app:cardCornerRadius="22dp" app:cardElevation="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="21dp">
                    <TextView android:id="@+id/etiquetaCursoEducativo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/fundo_selo_conteudo_home" android:paddingStart="11dp" android:paddingTop="6dp" android:paddingEnd="11dp" android:paddingBottom="6dp" android:text="CURSO EDUCATIVO" android:fontFamily="@font/nunito_bold" android:textColor="@color/verde_escuro_principal" android:textSize="11sp"/>
                    <ImageView android:id="@+id/imagemCursoEducativo" android:layout_width="match_parent" android:layout_height="152dp" android:layout_marginTop="9dp" android:scaleType="fitCenter" android:contentDescription="Ilustração do curso"/>
                    <TextView android:id="@+id/tituloCursoEducativo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Guia completo de reciclagem" android:fontFamily="@font/nunito_extrabold" android:textColor="@color/verde_escuro_principal" android:textSize="27sp"/>
                    <TextView android:id="@+id/descricaoCursoEducativo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Aprenda no seu ritmo, com pequenas aulas." android:fontFamily="@font/nunito_regular" android:textColor="@color/cinza_texto_home" android:lineSpacingExtra="3dp" android:textSize="15sp"/>
                    <TextView android:id="@+id/indicadoresCursoEducativo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:text="2 aulas  •  No seu ritmo" android:fontFamily="@font/nunito_bold" android:textColor="@color/verde_escuro_principal" android:textSize="13sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="29dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Aulas do curso" android:fontFamily="@font/nunito_bold" android:textColor="@color/verde_escuro_principal" android:textSize="21sp"/>
                <TextView android:id="@+id/contagemAulasCursoEducativo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/3 concluídas" android:fontFamily="@font/nunito_bold" android:textColor="@color/cinza_texto_auxiliar" android:textSize="12sp"/>
            </LinearLayout>
            <ProgressBar android:id="@+id/progressoCursoEducativo" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="9dp" android:layout_marginTop="13dp" android:max="100" android:progress="0" android:progressTint="@color/verde_escuro_principal" android:progressBackgroundTint="@color/verde_claro_ecociente"/>
            <LinearLayout android:id="@+id/listaAulasCursoEducativo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"/>

            </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton android:id="@+id/botaoContinuarCursoEducativo" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginStart="20dp" android:layout_marginTop="9dp" android:layout_marginEnd="20dp" android:layout_marginBottom="12dp" android:text="Começar primeira aula" android:textAllCaps="false" android:fontFamily="@font/nunito_bold" android:textSize="16sp" android:textColor="@color/branco" app:backgroundTint="@color/verde_escuro_principal" app:cornerRadius="15dp"/>
</LinearLayout>
