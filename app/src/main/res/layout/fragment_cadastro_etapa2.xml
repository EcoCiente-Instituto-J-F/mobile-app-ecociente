<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="28dp">

        <ImageView
            android:id="@+id/botaoVoltarEtapa1"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:clickable="true"
            android:contentDescription="Voltar"
            android:focusable="true"
            android:src="@drawable/ic_voltar"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tituloCadastroEtapa2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_semibold"
            android:text="Cadastrar-se"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="24sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/containerEtapasEtapa2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tituloCadastroEtapa2">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_regular"
                android:text="Passo 2 de 2"
                android:textColor="#222222"
                android:textSize="12sp" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/fundo_ponto_cinza" />

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/fundo_ponto_verde" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerEndereco"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="45dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerEtapasEtapa2"
            app:strokeColor="@color/verde_escuro_principal"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="16dp"
                    android:contentDescription="Localização"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_localizacao_cadastro" />

                <EditText
                    android:id="@+id/campoEndereco"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/nunito_medium"
                    android:hint="Endereço"
                    android:imeOptions="actionNext"
                    android:inputType="textPostalAddress|textCapWords"
                    android:padding="0dp"
                    android:textColor="@color/verde_escuro_principal"
                    android:textColorHint="@color/cinza_escuro_textos"
                    android:textSize="10sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/linhaNumeroCep"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerEndereco">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerNumero"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="9dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/verde_escuro_principal"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/campoNumero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/nunito_medium"
                    android:hint="Número"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/verde_escuro_principal"
                    android:textColorHint="@color/cinza_escuro_textos"
                    android:textSize="10sp" />

            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="8dp"
                android:layout_height="match_parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerCep"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="9dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/verde_escuro_principal"
                app:strokeWidth="1dp">

                <EditText
                    android:id="@+id/campoCep"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/nunito_medium"
                    android:hint="CEP"
                    android:imeOptions="actionNext"
                    android:inputType="number"
                    android:maxLength="9"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:textColor="@color/verde_escuro_principal"
                    android:textColorHint="@color/cinza_escuro_textos"
                    android:textSize="10sp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerComplemento"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linhaNumeroCep"
            app:strokeColor="@color/verde_escuro_principal"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/campoComplemento"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/nunito_medium"
                android:hint="Complemento (Opcional)"
                android:imeOptions="actionNext"
                android:inputType="textCapSentences"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/verde_escuro_principal"
                android:textColorHint="@color/cinza_escuro_textos"
                android:textSize="10sp" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerCidade"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerComplemento"
            app:strokeColor="@color/verde_escuro_principal"
            app:strokeWidth="1dp">

            <EditText
                android:id="@+id/campoCidade"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:fontFamily="@font/nunito_medium"
                android:hint="Cidade"
                android:imeOptions="actionNext"
                android:inputType="textCapWords"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="@color/verde_escuro_principal"
                android:textColorHint="@color/cinza_escuro_textos"
                android:textSize="10sp" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerEstado"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="9dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerCidade"
            app:strokeColor="@color/verde_escuro_principal"
            app:strokeWidth="1dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <AutoCompleteTextView
                    android:id="@+id/campoEstado"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toStartOf="@id/iconeSetaEstado"
                    android:background="@android:color/transparent"
                    android:cursorVisible="false"
                    android:fontFamily="@font/nunito_medium"
                    android:hint="Estado"
                    android:inputType="none"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/verde_escuro_principal"
                    android:textColorHint="@color/cinza_escuro_textos"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/iconeSetaEstado"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="Abrir lista de estados"
                    android:focusable="true"
                    android:padding="9dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_seta_baixo" />

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/containerBotaoCadastrar"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="61dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerEstado">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoCadastrar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/cadastrar_se"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="14sp"
                app:backgroundTint="@color/verde_escuro_principal"
                app:cornerRadius="9dp"
                app:elevation="0dp" />

            <ProgressBar
                android:id="@+id/indicadorCarregamentoCadastro"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/branco"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>