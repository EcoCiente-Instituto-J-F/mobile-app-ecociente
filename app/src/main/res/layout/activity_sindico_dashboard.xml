<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizSindicoDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/voltarSindicoDashboard"
            style="@style/BotaoVoltar"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:contentDescription="@string/sindico_voltar_a_home" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/sindico_dashboard"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="22sp" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="84dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/sindico_dashboard_notebook" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="110dp"
                        android:background="@drawable/fundo_cartao_borda"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/valor_indisponivel"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/sindico_total_de_aulas_concluidas"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="110dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fundo_cartao_borda"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/valor_indisponivel"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/sindico_moradores_utilizando_o_app"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="110dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fundo_cartao_borda"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/valor_indisponivel"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/sindico_media_de_pontos_por_pessoa"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_quizzes_com_maiores_notas"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="17sp" />
                <com.example.ecociente.views.SindicoDashboardGraficoView
                    android:id="@+id/graficoQuizzesSindico"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/sindico_notas_ilustrativas_compostagem_14" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:contentDescription="@string/sindico_deslize_para_ver_materiais_recicla"
                android:fillViewport="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">
            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_materiais_reciclados"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="17sp" />
                <com.example.ecociente.views.SindicoDashboardRoscaView
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/sindico_materiais_reciclados" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_regular"
                    android:gravity="center"
                    android:text="@string/valor_indisponivel"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_analise_por_cooperativa"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="17sp" />
                <com.example.ecociente.views.SindicoDashboardGraficoView
                    android:id="@+id/graficoCooperativasSindico"
                    android:layout_width="match_parent"
                    android:layout_height="205dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/sindico_coletas_ilustrativas_coop_estrela" />
            </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraInferiorSindico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
