<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizSindicoDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/voltarSindicoDashboard"
            style="@style/BotaoVoltar"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:contentDescription="@string/sindico_voltar_a_home" />
        <TextView
            android:id="@+id/tituloSindicoDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/sindico_dashboard"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="22sp" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <ImageView
            android:layout_width="84dp"
            android:layout_height="56dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/sindico_dashboard_notebook" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:minHeight="110dp"
                        android:background="@drawable/fundo_cartao_borda"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/valorAulasConcluidas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            tools:text="80"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/sindico_dash_descartes"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:minHeight="110dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fundo_cartao_borda"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/valorMoradoresNoApp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            tools:text="1.200"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/sindico_dash_moradores"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:minHeight="110dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/fundo_cartao_borda"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:id="@+id/valorPontosDoMes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            tools:text="300 pts"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="26sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/sindico_dash_coletas"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_dash_semanas"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="17sp" />
                <com.example.ecociente.views.SindicoDashboardGraficoView
                    android:id="@+id/graficoQuizzesSindico"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipToPadding="false"
                android:contentDescription="@string/sindico_deslize_para_ver_materiais_recicla"
                android:fillViewport="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">
            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_materiais_reciclados"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="17sp" />
                <com.example.ecociente.views.SindicoDashboardRoscaView
                    android:id="@+id/roscaMateriaisSindico"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="8dp" />
                <TextView
                    android:id="@+id/textoMateriaisPercentuais"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_regular"
                    android:gravity="center"
                    tools:text="Papel 25%  ·  Plástico 50%  ·  Vidro 8%"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_dash_cooperativas"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="17sp" />
                <com.example.ecociente.views.SindicoDashboardGraficoView
                    android:id="@+id/graficoCooperativasSindico"
                    android:layout_width="match_parent"
                    android:layout_height="205dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraInferiorSindico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
