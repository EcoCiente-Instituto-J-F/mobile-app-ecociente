<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizSindicoDashboard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/branco"
    tools:context=".views.SindicoDashboardActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/voltarSindicoDashboard"
            style="@style/BotaoVoltar"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:contentDescription="@string/sindico_voltar_a_home" />

        <TextView
            android:id="@+id/tituloSindicoDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/sindico_dashboard"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="22sp" />

        <ImageView
            android:layout_width="68dp"
            android:layout_height="50dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/sindico_dashboard_notebook" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoTentarDashboard"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/tentar_novamente"
        android:textAllCaps="false"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/sindico_dashboard_visao_geral"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito_regular"
                android:text="@string/sindico_dashboard_subtitulo"
                android:textColor="@color/cinza_texto_home"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:background="@drawable/fundo_cartao_borda"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/valorAulasConcluidas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="26sp"
                        tools:text="80" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/sindico_dash_descartes"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/fundo_cartao_borda"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/valorMoradoresNoApp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="26sp"
                        tools:text="120" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/sindico_dash_moradores"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_weight="1"
                    android:background="@drawable/fundo_cartao_borda"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/valorColetasRealizadas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="26sp"
                        tools:text="18" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/sindico_dash_coletas"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/fundo_cartao_borda"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/valorPontosDoMes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="26sp"
                        tools:text="300" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/sindico_dash_pontos"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_materiais_reciclados"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="16sp" />

                <com.example.ecociente.ui.SindicoDashboardRoscaView
                    android:id="@+id/roscaMateriaisSindico"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textoMateriaisPercentuais"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_regular"
                    android:gravity="center"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="12sp"
                    tools:text="Papel 25% · Plástico 50% · Vidro 8%" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_dash_cooperativas"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textoSemColetasCooperativasDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="@string/sindico_sem_coletas_realizadas"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.example.ecociente.ui.SindicoDashboardGraficoView
                    android:id="@+id/graficoCooperativasSindico"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/sindico_dash_semanas"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textoSemQuizzesDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="@string/sindico_sem_quizzes"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <com.example.ecociente.ui.SindicoDashboardGraficoView
                    android:id="@+id/graficoQuizzesSindico"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraInferiorSindico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>