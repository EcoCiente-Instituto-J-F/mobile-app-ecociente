<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizSindicoValidacao"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tituloSindicoValidacao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:paddingStart="26dp"
        android:paddingTop="22dp"
        android:paddingEnd="26dp"
        android:paddingBottom="4dp"
        android:text="@string/validacao_titulo"
        android:textColor="@color/rosa_ecociente"
        android:textSize="22sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_regular"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="8dp"
        android:text="@string/validacao_descricao"
        android:textColor="@color/cinza_texto_home"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/listaSindicoValidacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp" />
    </ScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraInferiorSindico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
