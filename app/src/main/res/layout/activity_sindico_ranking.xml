<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raizSindicoRanking"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="86dp">
        <ImageButton
            android:id="@+id/voltarSindicoRanking"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar à home"
            android:padding="13dp"
            android:src="@drawable/sindico_voltar" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="40dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/nunito_bold"
            android:text="Ranking"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="21sp" />
        <ImageView
            android:layout_width="104dp"
            android:layout_height="64dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="22dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/sindico_ranking_casa"
            android:translationY="13dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/sindico_ranking_modo_fundo"
        android:orientation="horizontal"
        android:padding="3dp">
        <TextView
            android:id="@+id/rankingPorBloco"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/sindico_ranking_modo_ativo"
            android:clickable="true"
            android:contentDescription="Ranking por bloco ou torre, selecionado"
            android:drawableStart="@drawable/sindico_ranking_icone_modo"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Por bloco/torre"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/rankingPorApartamento"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:contentDescription="Ver ranking por apartamento"
            android:drawableStart="@drawable/sindico_ranking_icone_modo"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="4dp"
            android:text="Por apartamento"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="11sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="36dp"
                android:gravity="center_horizontal"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/avatarSegundoRanking"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/sindico_ranking_avatar_segundo"
                        android:fontFamily="@font/nunito_bold"
                        android:gravity="center"
                        android:textColor="@color/preto_texto_home"
                        android:textSize="14sp" />
                    <LinearLayout
                        android:layout_width="70dp"
                        android:layout_height="57dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/sindico_ranking_podio_lateral"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="2º"
                            android:textColor="@color/preto_texto_home"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/pontosSegundoRanking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/avatarPrimeiroRanking"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:background="@drawable/sindico_ranking_avatar_primeiro"
                        android:fontFamily="@font/nunito_bold"
                        android:gravity="center"
                        android:textColor="@color/preto_texto_home"
                        android:textSize="15sp" />
                    <LinearLayout
                        android:layout_width="70dp"
                        android:layout_height="63dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/sindico_ranking_podio_primeiro"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="1º"
                            android:textColor="@color/branco"
                            android:textSize="19sp" />
                        <TextView
                            android:id="@+id/pontosPrimeiroRanking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:textColor="@color/branco"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="45dp"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/avatarTerceiroRanking"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/sindico_ranking_avatar_terceiro"
                        android:fontFamily="@font/nunito_bold"
                        android:gravity="center"
                        android:textColor="@color/preto_texto_home"
                        android:textSize="14sp" />
                    <LinearLayout
                        android:layout_width="70dp"
                        android:layout_height="57dp"
                        android:layout_marginTop="5dp"
                        android:background="@drawable/sindico_ranking_podio_lateral"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_bold"
                            android:text="3º"
                            android:textColor="@color/preto_texto_home"
                            android:textSize="18sp" />
                        <TextView
                            android:id="@+id/pontosTerceiroRanking"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/listaSindicoRankingCompleta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/sindico_ranking_lista_fundo"
                android:orientation="vertical"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </LinearLayout>
    </ScrollView>

    <com.example.ecociente.views.SindicoBottomBar
        android:id="@+id/barraInferiorSindico"
        android:layout_width="match_parent"
        android:layout_height="86dp" />
</LinearLayout>
