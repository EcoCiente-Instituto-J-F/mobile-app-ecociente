<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/raizBiblioteca" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/branco">
  <androidx.core.widget.NestedScrollView android:id="@+id/rolagemBiblioteca" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:fillViewport="false" android:scrollbars="none" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/barraNavegacao" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="35dp">
      <FrameLayout android:id="@+id/cabecalhoBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="20dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="7dp" android:paddingStart="8dp" android:paddingEnd="8dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Biblioteca educativa" android:fontFamily="@font/nunito_bold" android:gravity="center" android:textColor="@color/verde_escuro_principal" android:textSize="26sp"/>
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Aprenda, pratique e ajude a construir um futuro sustentável." android:fontFamily="@font/nunito_regular" android:textColor="@color/cinza_texto_home" android:gravity="center" android:textSize="15sp" android:lineSpacingExtra="2dp"/>
        </LinearLayout>
      </FrameLayout>
      <FrameLayout android:id="@+id/blocoPesquisaBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="20dp" android:layout_marginEnd="20dp" android:clipChildren="false" android:clipToPadding="false">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="55dp" app:cardBackgroundColor="@color/branco" app:cardCornerRadius="11dp" app:cardElevation="3dp" app:strokeColor="@color/cinza_borda_home" app:strokeWidth="1dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="60dp">
            <ImageView android:layout_width="23dp" android:layout_height="23dp" android:contentDescription="@string/buscar" android:src="@drawable/ic_busca"/>
            <EditText android:id="@+id/campoPesquisaBiblioteca" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_weight="1" android:background="@android:color/transparent" android:fontFamily="@font/nunito_regular" android:hint="@string/pesquise" android:singleLine="true" android:inputType="text" android:imeOptions="actionSearch" android:textSize="15sp" android:importantForAutofill="no" android:textColorHint="@color/cinza_escuro_textos" android:textColor="@color/verde_escuro_principal"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <ImageView android:layout_width="82dp" android:layout_height="82dp" android:layout_gravity="top|end" android:layout_marginEnd="12dp" android:padding="0dp" android:rotation="-8" android:src="@drawable/ic_guia_verde" android:contentDescription="@null" android:id="@+id/livroDecorativoBiblioteca" android:elevation="8dp" android:importantForAccessibility="no" android:clickable="false" android:focusable="false" android:layout_marginTop="22dp"/>
      </FrameLayout>
      <TextView android:id="@+id/textoEstadoBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginTop="16dp" android:layout_marginEnd="24dp" android:fontFamily="@font/nunito_regular" android:gravity="center" android:text="Carregando conteúdos..." android:textColor="@color/cinza_texto_auxiliar" android:textSize="13sp"/>
      <com.google.android.material.button.MaterialButton android:id="@+id/botaoRecarregarBiblioteca" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:text="Tentar novamente" android:textAllCaps="false" android:visibility="gone" app:backgroundTint="@color/verde_escuro_principal" app:cornerRadius="12dp"/>
      <LinearLayout android:id="@+id/secaoDestaquesBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="vertical" android:visibility="gone">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="16dp" android:fontFamily="@font/nunito_bold" android:text="Conteúdos em destaque" android:textSize="20sp" android:textColor="@color/verde_escuro_principal"/>
        <HorizontalScrollView android:id="@+id/rolagemDestaquesBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:clipToPadding="false" android:fillViewport="false" android:scrollbars="none">
          <LinearLayout android:id="@+id/listaDestaquesBiblioteca" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="20dp" android:paddingEnd="20dp"/>
        </HorizontalScrollView>
      </LinearLayout>
      <LinearLayout android:id="@+id/secaoAulasBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="25dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
          <TextView android:id="@+id/textoCursoSelecionado" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Aulas do curso" android:fontFamily="@font/nunito_bold" android:textColor="@color/verde_escuro_principal" android:textSize="18sp"/>
          <TextView android:id="@+id/botaoFecharAulasBiblioteca" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center_vertical" android:text="Fechar  ✕" android:textColor="@color/cinza_texto_auxiliar" android:fontFamily="@font/nunito_semibold" android:textSize="13sp"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/listaAulasBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
      </LinearLayout>
      <LinearLayout android:id="@+id/secaoSalvosBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="21dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:orientation="horizontal" android:gravity="center_vertical">
          <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Conteúdos salvos" android:fontFamily="@font/nunito_bold" android:textColor="@color/verde_escuro_principal" android:textSize="19sp"/>
          <TextView android:id="@+id/botaoVerTodosSalvos" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:text="Ver todos" android:textSize="13sp" android:fontFamily="@font/nunito_semibold" android:textColor="@color/verde_escuro_principal"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/listaSalvosBiblioteca" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"/>
      </LinearLayout>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <com.example.ecociente.ui.BarraNavegacaoView android:id="@+id/barraNavegacao" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
