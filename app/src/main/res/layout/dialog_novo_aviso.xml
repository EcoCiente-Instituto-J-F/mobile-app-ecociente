<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_notificacoes"
                app:tint="@color/rosa_ecociente" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/criar_notificacao"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/botaoFecharNovoAviso"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/fechar"
                android:padding="6dp"
                android:src="@drawable/ic_fechar"
                app:tint="@color/verde_escuro_principal" />

        </LinearLayout>

        <TextView
            style="@style/RotuloCampoModal"
            android:text="@string/titulo_aviso" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoTituloAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/digite_seu_titulo"
                android:inputType="textCapSentences"
                android:maxLength="255"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/RotuloCampoModal"
            android:text="@string/destinatarios" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <AutoCompleteTextView
                android:id="@+id/campoDestinoAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/selecione_destinatarios"
                android:inputType="none"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/RotuloCampoModal"
            android:text="@string/mensagem" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoMensagemAviso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/escreva_sua_mensagem"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="4"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoCancelarNovoAviso"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/perfil_cancelar"
                android:textAllCaps="false"
                android:textColor="@color/verde_escuro_principal"
                app:cornerRadius="8dp"
                app:strokeColor="@color/verde_escuro_principal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoEnviarNovoAviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/nunito_semibold"
                android:text="@string/enviar_notificacao"
                android:textAllCaps="false"
                app:backgroundTint="@color/verde_escuro_principal"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
