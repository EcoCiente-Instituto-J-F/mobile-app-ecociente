<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="18dp"
    android:gravity="top"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/textoIniciaisMensagem"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/fundo_avatar_iniciais"
        android:fontFamily="@font/nunito_bold"
        android:gravity="center"
        android:textColor="@color/verde_escuro_principal"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="30dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="7dp"
            app:cardElevation="4dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <TextView
                android:id="@+id/textoMensagemRecebida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_bolha_eko"
                android:fontFamily="@font/nunito_regular"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/black"
                android:textSize="12sp" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/horaMensagemRecebida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_regular"
            android:textColor="@color/cinza_texto_auxiliar"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
