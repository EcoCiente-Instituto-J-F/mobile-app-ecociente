<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fundo_cartao_borda"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_notificacoes"
                app:tint="@color/rosa_ecociente" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/sindico_criar_notificacao"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="20sp" />
            <ImageView
                android:id="@+id/botaoFecharCriarAviso"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sindico_fechar_criacao_de_notificacao"
                android:padding="11dp"
                android:src="@drawable/ic_fechar" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/titulo_aviso"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="13sp" />
        <EditText
            android:importantForAutofill="no"
            android:id="@+id/campoTituloAviso"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/sindico_campo"
            android:hint="@string/sindico_digite_seu_titulo"
            android:inputType="textCapSentences"
            android:maxLength="100"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/preto_texto_home"
            android:textColorHint="@color/cinza_texto_home"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/sindico_destinatario"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/campoDestinatarioAviso"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/sindico_campo"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/sindico_todos_os_moradores"
            android:textColor="@color/preto_texto_home"
            android:textSize="13sp" />

        <TextView
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/mensagem"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="13sp" />
        <EditText
            android:importantForAutofill="no"
            android:id="@+id/campoMensagemAviso"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/sindico_campo"
            android:gravity="top|start"
            android:hint="@string/sindico_escreva_sua_mensagem"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:padding="12dp"
            android:textColor="@color/preto_texto_home"
            android:textColorHint="@color/cinza_texto_home"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="end"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoCancelarAviso"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/perfil_cancelar"
                android:textAllCaps="false"
                android:textColor="@color/verde_escuro_principal" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoSalvarAviso"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:backgroundTint="@color/verde_escuro_principal"
                android:text="@string/enviar_notificacao"
                android:textAllCaps="false"
                android:textColor="@color/branco" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
