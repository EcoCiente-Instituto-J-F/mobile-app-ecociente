<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    android:paddingStart="28dp"
    android:paddingTop="28dp"
    android:paddingEnd="28dp"
    android:paddingBottom="28dp"
    tools:context=".controller.EsqueciSenhaNovaSenhaFragment">

    <TextView
        android:id="@+id/tituloNovaSenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_semibold"
        android:text="Nova senha"
        android:textColor="@color/verde_escuro_principal"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtituloNovaSenha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/nunito_medium"
        android:text="Digite sua nova senha para continuar"
        android:textColor="@color/cinza_escuro_textos"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloNovaSenha" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/containerSenha"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtituloNovaSenha"
        app:strokeColor="@color/verde_escuro_principal"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/iconeOlhoSenha"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Ícone senha"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_senha" />

                <EditText
                    android:id="@+id/campoSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/nunito_medium"
                    android:hint="Senha"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:textColor="@color/verde_escuro_principal"
                    android:textColorHint="@color/cinza_escuro_textos"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/iconeOlhoSenha"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Mostrar senha"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/icon_olho_fechado" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/containerConfirmarSenha"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerSenha"
        app:strokeColor="@color/verde_escuro_principal"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/iconeOlhoConfirmarSenha"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Ícone confirmar senha"
                    android:scaleType="fitCenter"
                    android:src="@drawable/icon_senha" />

                <EditText
                    android:id="@+id/campoConfirmarSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autofillHints="newPassword"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/nunito_medium"
                    android:hint="Confirmar senha"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:padding="0dp"
                    android:textColor="@color/verde_escuro_principal"
                    android:textColorHint="@color/cinza_escuro_textos"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/iconeOlhoConfirmarSenha"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Mostrar confirmação de senha"
                android:focusable="true"
                android:padding="9dp"
                android:scaleType="centerInside"
                android:src="@drawable/icon_olho_fechado" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoContinuar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/nunito_semibold"
        android:text="Continuar"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="16sp"
        app:backgroundTint="@color/verde_escuro_principal"
        app:cornerRadius="12dp"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerConfirmarSenha" />

</androidx.constraintlayout.widget.ConstraintLayout>
