<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    tools:ignore="Overdraw" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/branco"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/filtrar_conteudos"
            android:textColor="@color/rosa_ecociente"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/filtro_categoria"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/filtro_ordenar"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/grupoOrdem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <RadioButton
                android:id="@+id/radioOrdemCurso"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/nunito_regular"
                android:text="@string/filtro_ordem_curso"
                android:textColor="@color/cinza_texto_home" />

            <RadioButton
                android:id="@+id/radioOrdemAz"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:fontFamily="@font/nunito_regular"
                android:text="@string/filtro_ordem_az"
                android:textColor="@color/cinza_texto_home" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/filtro_tempo"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsTempo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoLimparFiltro"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/filtro_limpar"
                android:textColor="@color/verde_escuro_principal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoAplicarFiltro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="@color/verde_escuro_principal"
                android:text="@string/filtro_aplicar"
                android:textColor="@color/branco" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
