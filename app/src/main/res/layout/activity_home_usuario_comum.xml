<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/raizHomeUsuarioComum"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/branco"

    android:clipChildren="false"
    android:clipToPadding="false"

    tools:context=".views.MainActivity">


    <!-- ===================================================== -->
    <!-- CABEÇALHO                                             -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/cabecalhoHome"

        android:layout_width="0dp"
        android:layout_height="64dp"

        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <!-- LOGO -->

        <ImageView
            android:id="@+id/imagemLogoHome"

            android:layout_width="136dp"
            android:layout_height="44dp"

            android:layout_gravity="center"

            android:adjustViewBounds="true"

            android:contentDescription="@string/logo_ecociente"

            android:scaleType="fitCenter"

            android:src="@drawable/logo_ecociente"

            app:tint="@color/verde_escuro_principal" />


        <!-- NOTIFICAÇÃO + PERFIL -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:layout_gravity="end"

            android:gravity="center_vertical"

            android:orientation="horizontal"

            android:translationY="4dp">


            <ImageView
                android:id="@+id/botaoNotificacoes"

                android:layout_width="26dp"
                android:layout_height="26dp"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:contentDescription="@string/notificacoes"

                android:padding="2dp"

                android:scaleType="centerInside"

                android:src="@drawable/icon_notificacoes" />


            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"

                android:layout_marginStart="7dp"

                app:cardBackgroundColor="@color/cinza_fundo_imagem_home"

                app:cardCornerRadius="20dp"

                app:cardElevation="0dp">


                <ImageView
                    android:id="@+id/imagemPerfilHome"

                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:contentDescription="@string/foto_perfil"

                    android:padding="5dp"

                    android:scaleType="centerCrop"

                    android:src="@drawable/ic_perfil_usuario" />

            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </FrameLayout>



    <!-- ===================================================== -->
    <!-- SAUDAÇÃO                                              -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/textoSaudacao"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="26dp"
        android:layout_marginTop="10dp"

        android:fontFamily="@font/nunito_bold"

        android:textColor="@color/rosa_ecociente"

        android:textSize="22sp"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/cabecalhoHome"

        tools:text="Olá, Julio!" />


    <TextView
        android:id="@+id/textoMensagemMotivacional"

        android:layout_width="250dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="26dp"
        android:layout_marginTop="2dp"

        android:fontFamily="@font/nunito_regular"

        android:lineSpacingExtra="1dp"

        android:minHeight="42dp"

        android:text="@string/mensagem_motivacional_padrao"

        android:textColor="@color/cinza_texto_home"

        android:textSize="14sp"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintTop_toBottomOf="@id/textoSaudacao" />



    <!-- ===================================================== -->
    <!-- CARD - ANÁLISE DO QUIZ                                -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAnaliseQuiz"

        android:layout_width="0dp"
        android:layout_height="238dp"

        android:layout_marginStart="11dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="11dp"

        android:clickable="true"

        android:focusable="true"

        android:foreground="?attr/selectableItemBackground"

        app:cardBackgroundColor="@color/branco"

        app:cardCornerRadius="15dp"

        app:cardElevation="3dp"

        app:strokeColor="@color/cinza_borda_home"

        app:strokeWidth="1dp"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toBottomOf="@id/textoMensagemMotivacional">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:orientation="vertical"

            android:paddingStart="13dp"
            android:paddingTop="11dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp">


            <!-- TÍTULO + MÉDIA -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"

                android:orientation="horizontal">


                <ImageView
                    android:id="@+id/imagemIconeAnalise"

                    android:layout_width="25dp"
                    android:layout_height="25dp"

                    android:contentDescription="@string/icone_analise_quiz"

                    android:scaleType="centerInside"

                    android:src="@drawable/icon_grafico" />


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="8dp"

                    android:layout_weight="1"

                    android:fontFamily="@font/nunito_bold"

                    android:text="@string/analise_quiz"

                    android:textColor="@color/verde_escuro_principal"

                    android:textSize="14sp" />


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginEnd="14dp"

                    android:gravity="center"

                    android:orientation="vertical">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:fontFamily="@font/nunito_bold"

                        android:text="@string/media_acertos"

                        android:textColor="@color/verde_escuro_principal"

                        android:textSize="8sp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:fontFamily="@font/nunito_extrabold"

                        android:text="75%"

                        android:textColor="@color/verde_escuro_principal"

                        android:textSize="15sp" />

                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:fontFamily="@font/nunito_bold"

                    android:text="›"

                    android:textColor="@color/verde_escuro_principal"

                    android:textSize="24sp" />

            </LinearLayout>


            <!-- DESCRIÇÃO -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="1dp"

                android:fontFamily="@font/nunito_regular"

                android:text="@string/acompanhe_quizzes"

                android:textColor="@color/cinza_texto_home"

                android:textSize="10sp" />


            <!-- GRÁFICO -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"

                android:layout_marginTop="7dp"

                android:layout_weight="1"

                app:cardBackgroundColor="@color/branco"

                app:cardCornerRadius="11dp"

                app:cardElevation="0dp"

                app:strokeColor="@color/cinza_borda_clara_home"

                app:strokeWidth="1dp">


                <com.example.ecociente.views.QuizPerformanceView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"

                    android:contentDescription="@string/grafico_desempenho" />


            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>



    <!-- ===================================================== -->
    <!-- CONTEÚDOS PARA VOCÊ                                   -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/cabecalhoConteudos"

        android:layout_width="0dp"
        android:layout_height="32dp"

        android:layout_marginStart="18dp"
        android:layout_marginTop="42dp"
        android:layout_marginEnd="18dp"

        android:gravity="center_vertical"

        android:orientation="horizontal"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toBottomOf="@id/cardAnaliseQuiz">


        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"

            android:contentDescription="@string/icone_conteudos"

            android:scaleType="centerInside"

            android:src="@drawable/icon_livro" />


        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            android:layout_marginStart="8dp"

            android:layout_weight="1"

            android:fontFamily="@font/nunito_bold"

            android:text="@string/conteudos_para_voce"

            android:textColor="@color/verde_escuro_principal"

            android:textSize="15sp" />


        <LinearLayout
            android:id="@+id/acaoVerTodos"

            android:layout_width="wrap_content"
            android:layout_height="match_parent"

            android:layout_marginEnd="6dp"

            android:background="?attr/selectableItemBackgroundBorderless"

            android:clickable="true"
            android:focusable="true"

            android:gravity="center_vertical"

            android:orientation="horizontal">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/nunito_semibold"

                android:includeFontPadding="false"

                android:text="@string/ver_todos"

                android:textColor="@color/verde_escuro_principal"

                android:textSize="12sp" />


            <TextView
                android:layout_width="20dp"
                android:layout_height="match_parent"

                android:layout_marginStart="2dp"

                android:fontFamily="@font/nunito_bold"

                android:gravity="center"

                android:includeFontPadding="false"

                android:text="›"

                android:textColor="@color/verde_escuro_principal"

                android:textSize="20sp" />


        </LinearLayout>


    </LinearLayout>



    <!-- ===================================================== -->
    <!-- CARDS                                                 -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/listaConteudosHome"

        android:layout_width="0dp"
        android:layout_height="0dp"

        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="12dp"

        android:baselineAligned="false"

        android:orientation="horizontal"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toBottomOf="@id/cabecalhoConteudos"

        app:layout_constraintBottom_toTopOf="@id/barraNavegacaoHome"

        app:layout_constraintHeight_max="162dp"

        app:layout_constraintVertical_bias="0">


        <include
            android:id="@+id/cardConteudoGuia"

            layout="@layout/item_conteudo_home_guia"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_marginEnd="9dp"

            android:layout_weight="1" />


        <include
            android:id="@+id/cardConteudoDica"

            layout="@layout/item_conteudo_home_dica"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"

            android:layout_weight="1" />


        <include
            android:id="@+id/cardConteudoArtigo"

            layout="@layout/item_conteudo_home_artigo"

            android:layout_width="0dp"
            android:layout_height="match_parent"

            android:layout_marginStart="9dp"

            android:layout_weight="1" />


    </LinearLayout>



    <!-- ===================================================== -->
    <!-- BARRA DE NAVEGAÇÃO                                    -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/barraNavegacaoHome"

        android:layout_width="0dp"
        android:layout_height="64dp"

        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="8dp"

        android:background="@drawable/fundo_barra_navegacao_home"

        android:clipChildren="false"
        android:clipToPadding="false"

        android:elevation="0dp"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintBottom_toBottomOf="parent">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:clipChildren="false"
            android:clipToPadding="false"

            android:gravity="center"

            android:orientation="horizontal"

            android:weightSum="5">


            <!-- HOME -->

            <include
                android:id="@+id/navHome"

                layout="@layout/item_navegacao_home_inicio"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1" />


            <!-- GUIA -->

            <include
                android:id="@+id/navGuia"

                layout="@layout/item_navegacao_home_guia"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1" />


            <!-- ESPAÇO DO ASSISTENTE -->

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1" />


            <!-- QUIZ -->

            <include
                android:id="@+id/navQuiz"

                layout="@layout/item_navegacao_home_quiz"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1" />


            <!-- PERFIL -->

            <include
                android:id="@+id/navPerfil"

                layout="@layout/item_navegacao_home_perfil"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1" />


        </LinearLayout>


    </FrameLayout>


    <!-- ===================================================== -->
    <!-- ASSISTENTE CENTRAL                                    -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navAssistente"

        android:layout_width="68dp"
        android:layout_height="68dp"

        android:clickable="false"
        android:focusable="false"

        android:elevation="0dp"

        android:stateListAnimator="@null"

        android:translationY="-17dp"

        app:cardBackgroundColor="@color/verde_claro_ecociente"

        app:cardCornerRadius="34dp"

        app:cardElevation="0dp"

        app:strokeWidth="0dp"

        app:layout_constraintStart_toStartOf="parent"

        app:layout_constraintEnd_toEndOf="parent"

        app:layout_constraintTop_toTopOf="@id/barraNavegacaoHome">


        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"

            android:layout_gravity="center"

            android:contentDescription="@string/assistente"

            android:scaleType="centerInside"

            android:src="@drawable/icon_chatbot_verde"

            android:tint="@color/verde_escuro_principal"

            android:tintMode="src_in" />


    </com.google.android.material.card.MaterialCardView>


</androidx.constraintlayout.widget.ConstraintLayout>