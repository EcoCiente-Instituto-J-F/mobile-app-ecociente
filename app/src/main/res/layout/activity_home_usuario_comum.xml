<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizHomeUsuarioComum"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".views.MainActivity">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/atualizacaoHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/branco"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/rolagemHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:id="@+id/cabecalhoHome"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp">

                    <ImageView
                        android:id="@+id/imagemLogoHome"
                        android:layout_width="136dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/logo_ecociente"
                        android:scaleType="fitCenter"
                        android:src="@drawable/logo_ecociente"
                        app:tint="@color/verde_escuro_principal" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="end"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:translationY="4dp">

                        <ImageView
                            android:id="@+id/botaoNotificacoes"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/notificacoes"
                            android:padding="2dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_notificacoes" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="7dp"
                            app:cardBackgroundColor="@color/cinza_fundo_imagem_home"
                            app:cardCornerRadius="20dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/imagemPerfilHome"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/foto_perfil"
                                android:padding="5dp"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_perfil_usuario" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/textoSaudacao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/rosa_ecociente"
                    android:textSize="26sp"
                    tools:text="Olá, Julio!" />

                <TextView
                    android:id="@+id/textoMensagemMotivacional"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="36dp"
                    android:fontFamily="@font/nunito_regular"
                    android:lineSpacingExtra="2dp"
                    android:minHeight="48dp"
                    android:text="@string/mensagem_motivacional_padrao"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="16sp" />

                <include layout="@layout/card_pontos" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAnaliseQuiz"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="22dp"
                    android:layout_marginEnd="18dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/cinza_borda_home"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="15dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imagemIconeAnalise"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="@string/icone_analise_quiz"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_grafico" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/nunito_bold"
                                android:text="@string/analise_quiz"
                                android:textColor="@color/verde_escuro_principal"
                                android:textSize="18sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/nunito_bold"
                                android:text="@string/simbolo_avancar"
                                android:textColor="@color/verde_escuro_principal"
                                android:textSize="27sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/acompanhe_quizzes"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="13.5sp" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="190dp"
                            android:layout_marginTop="10dp"
                            app:cardBackgroundColor="@color/branco"
                            app:cardCornerRadius="14dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/cinza_borda_clara_home"
                            app:strokeWidth="1dp">

                            <com.example.ecociente.views.QuizPerformanceView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/grafico_desempenho" />

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/cabecalhoConteudos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginStart="18dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="29dp"
                        android:layout_height="29dp"
                        android:contentDescription="@string/icone_conteudos"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_guia_cinza"
                        app:tint="@color/verde_escuro_principal" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_bold"
                        android:text="@string/conteudos_para_voce"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:id="@+id/acaoVerTodos"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/ver_todos"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="2dp"
                            android:fontFamily="@font/nunito_bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/simbolo_avancar"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="22sp" />

                    </LinearLayout>

                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/rolagemConteudosHome"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="4dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/listaConteudosHome"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="18dp"
                        android:paddingBottom="4dp">

                        <include
                            android:id="@+id/cardConteudoGuia"
                            layout="@layout/item_conteudo_home_guia"
                            android:layout_width="158dp"
                            android:layout_height="212dp"
                            android:layout_marginEnd="12dp" />

                        <include
                            android:id="@+id/cardConteudoDica"
                            layout="@layout/item_conteudo_home_dica"
                            android:layout_width="158dp"
                            android:layout_height="212dp"
                            android:layout_marginEnd="12dp" />

                        <include
                            android:id="@+id/cardConteudoArtigo"
                            layout="@layout/item_conteudo_home_artigo"
                            android:layout_width="158dp"
                            android:layout_height="212dp"
                            android:layout_marginEnd="12dp" />

                        <include
                            android:id="@+id/cardConteudoGuiaExtra"
                            layout="@layout/item_conteudo_home_guia"
                            android:layout_width="158dp"
                            android:layout_height="212dp"
                            android:layout_marginEnd="12dp" />

                        <include
                            android:id="@+id/cardConteudoDicaExtra"
                            layout="@layout/item_conteudo_home_dica"
                            android:layout_width="158dp"
                            android:layout_height="212dp" />

                    </LinearLayout>

                </HorizontalScrollView>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>