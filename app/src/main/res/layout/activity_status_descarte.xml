<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizStatusDescarte"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".views.StatusDescarteActivity">

    <ImageView
        android:id="@+id/botaoVoltarStatusDescarte"
        style="@style/BotaoVoltar"
        android:contentDescription="@string/voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tituloStatusDescarte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="26dp"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/status_descarte_titulo"
        android:textColor="@color/rosa_ecociente"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/botaoVoltarStatusDescarte" />

    <TextView
        android:id="@+id/subtituloStatusDescarte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:fontFamily="@font/nunito_regular"
        android:text="@string/status_descarte_subtitulo"
        android:textColor="@color/cinza_texto_home"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloStatusDescarte" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtituloStatusDescarte">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="8dp"
            android:paddingEnd="26dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="@dimen/raio_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinza_borda_clara_home"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/fotoStatusDescarte"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:contentDescription="@string/registro_previa_foto"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/categoriaStatusDescarte"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@color/verde_claro_ecociente"
                            android:fontFamily="@font/nunito_bold"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="3dp"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/quandoStatusDescarte"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/nunito_regular"
                            android:textColor="@color/cinza_texto_home"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="@dimen/raio_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinza_borda_clara_home"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/etapasStatusDescarte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp" />

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/resultadoStatusDescarte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/verde_fundo_card_claro"
                app:cardCornerRadius="@dimen/raio_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinza_borda_card_perfil"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tituloResultadoStatusDescarte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textoResultadoStatusDescarte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/nunito_regular"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="13sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
