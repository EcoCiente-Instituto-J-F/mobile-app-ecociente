<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tituloCadastro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/cadastrar_se"
        android:textColor="@color/verde_escuro_principal"
        android:textSize="25sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/containerEtapas"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginTop="1dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloCadastro">

        <TextView
            android:id="@+id/textoPassoCadastro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/cadastro_passo_1"
            android:textColor="@color/cinza_texto_passo"
            android:textSize="11sp" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="9dp"
            android:background="@drawable/fundo_ponto_verde" />

        <View
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/fundo_ponto_cinza" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCadastroEtapa1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingTop="8dp"
        android:paddingBottom="22dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerEtapas">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tituloDadosPessoais"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/dados_pessoais"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerNome"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                app:cardBackgroundColor="@color/branco_fundo_campo"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tituloDadosPessoais"
                app:strokeColor="@color/verde_borda_campo"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@string/icone_usuario"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_usuario" />

                    <EditText
                        android:id="@+id/campoNome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="name"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/nunito_medium"
                        android:hint="@string/nome_e_sobrenome"
                        android:imeOptions="actionNext"
                        android:inputType="textPersonName|textCapWords"
                        android:padding="0dp"
                        android:textColor="@color/verde_escuro_principal"
                        android:textColorHint="@color/cinza_texto_suave"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerDataNascimento"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/branco_fundo_campo"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerNome"
                app:strokeColor="@color/verde_borda_campo"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:id="@+id/iconeCalendario"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/abrir_calendario"
                        android:focusable="true"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_calendario" />

                    <EditText
                        android:importantForAutofill="no"
                        android:id="@+id/campoDataNascimento"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/nunito_medium"
                        android:hint="@string/data_nascimento"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="10"
                        android:padding="0dp"
                        android:textColor="@color/verde_escuro_principal"
                        android:textColorHint="@color/cinza_texto_suave"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerEmailCadastro"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/branco_fundo_campo"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerDataNascimento"
                app:strokeColor="@color/verde_borda_campo"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/icone_email"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_email" />

                    <EditText
                        android:id="@+id/campoEmailCadastro"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:autofillHints="emailAddress"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/nunito_medium"
                        android:hint="@string/hint_email"
                        android:imeOptions="actionNext"
                        android:inputType="textEmailAddress"
                        android:padding="0dp"
                        android:textColor="@color/verde_escuro_principal"
                        android:textColorHint="@color/cinza_texto_suave"
                        android:textSize="15sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerSenhaCadastro"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/branco_fundo_campo"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerEmailCadastro"
                app:strokeColor="@color/verde_borda_campo"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="13dp"
                    android:paddingEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/iconeOlhoSenhaCadastro"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="17dp"
                            android:contentDescription="@string/icone_senha"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_senha" />

                        <EditText
                            android:id="@+id/campoSenhaCadastro"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:autofillHints="newPassword"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/nunito_medium"
                            android:hint="@string/senha"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:padding="0dp"
                            android:textColor="@color/verde_escuro_principal"
                            android:textColorHint="@color/cinza_texto_suave"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iconeOlhoSenhaCadastro"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/mostrar_senha"
                        android:focusable="true"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_olho_fechado" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/indicadorForcaSenha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerSenhaCadastro">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:orientation="horizontal">
                    <View android:id="@+id/forcaSenha1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@color/cinza_borda_clara_home" />
                    <View android:id="@+id/forcaSenha2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@color/cinza_borda_clara_home" />
                    <View android:id="@+id/forcaSenha3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@color/cinza_borda_clara_home" />
                    <View android:id="@+id/forcaSenha4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/cinza_borda_clara_home" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textoForcaSenha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/nunito_medium"
                    android:text="@string/senha_requisito_minimo"
                    android:textColor="@color/cinza_texto_auxiliar"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerConfirmarSenha"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/branco_fundo_campo"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/indicadorForcaSenha"
                app:strokeColor="@color/verde_borda_campo"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="13dp"
                    android:paddingEnd="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@id/iconeOlhoConfirmarSenha"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="17dp"
                            android:contentDescription="@string/icone_senha"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_senha" />

                        <EditText
                            android:id="@+id/campoConfirmarSenha"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:autofillHints="newPassword"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/nunito_medium"
                            android:hint="@string/confirmar_senha"
                            android:imeOptions="actionNext"
                            android:inputType="textPassword"
                            android:padding="0dp"
                            android:textColor="@color/verde_escuro_principal"
                            android:textColorHint="@color/cinza_texto_suave"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iconeOlhoConfirmarSenha"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/mostrar_senha"
                        android:focusable="true"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_olho_fechado" />

                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tituloCondominio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/condominio"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerConfirmarSenha" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardOpcaoCondominio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:cardBackgroundColor="@color/verde_fundo_card_claro"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tituloCondominio"
                app:strokeColor="@color/cinza_borda_card_perfil"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:id="@+id/linhaPossuiCodigoCondominio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="46dp"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="5dp">

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkPossuiCodigoCondominio"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:buttonIconTint="@color/checkbox_check_branco"
                        app:buttonTint="@color/verde_escuro_principal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/nunito_semibold"
                            android:text="@string/possui_codigo_condominio"
                            android:textColor="@color/cinza_texto_opcao"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/codigo_condominio_descricao"
                            android:textColor="@color/cinza_texto_auxiliar"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/containerCodigoCondominio"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/cinza_fundo_desabilitado"
                app:cardCornerRadius="11dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardOpcaoCondominio"
                app:strokeColor="@color/cinza_borda_desabilitada"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="17dp"
                        android:alpha="0.65"
                        android:contentDescription="@string/icone_codigo_condominio"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_senha"/>

                    <EditText
                        android:importantForAutofill="no"
                        android:id="@+id/campoCodigoCondominio"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:enabled="false"
                        android:fontFamily="@font/nunito_medium"
                        android:hint="@string/codigo_condominio"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters"
                        android:padding="0dp"
                        android:textColor="@color/verde_escuro_principal"
                        android:textColorHint="@color/cinza_hint_desabilitado"
                        android:textSize="15sp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:id="@+id/containerBotaoContinuar"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerCodigoCondominio">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoContinuar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/continuar"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="16sp"
                    app:backgroundTint="@color/verde_escuro_principal"
                    app:cornerRadius="11dp"
                    app:elevation="0dp"/>

                <ProgressBar
                    android:id="@+id/indicadorCarregamentoCadastroEtapa1"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/branco"
                    android:visibility="gone"/>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
