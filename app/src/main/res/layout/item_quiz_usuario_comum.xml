<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/branco"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cinza_borda_home"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="122dp"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="11dp"
        android:paddingBottom="14dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/fundoIconeQuiz"
            android:layout_width="58dp"
            android:layout_height="58dp"
            app:cardBackgroundColor="@color/verde_selo_home"
            app:cardCornerRadius="29dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imagemIconeQuiz"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/icone_quiz"
                android:padding="15dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_reciclar_chat"
                app:tint="@color/verde_escuro_principal" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/setaQuiz"
            android:layout_width="18dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="›"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="28sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/areaAcaoQuiz"
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/setaQuiz"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/boxResultadoQuiz"
                android:layout_width="94dp"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_selo_conteudo_home"
                android:gravity="center"
                android:minHeight="48dp"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:includeFontPadding="false"
                    android:text="@string/concluido"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textoResultadoQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/nunito_regular"
                    android:includeFontPadding="false"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="11.5sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoComecarQuiz"
                android:layout_width="94dp"
                android:layout_height="38dp"
                android:fontFamily="@font/nunito_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/comecar"
                android:textAllCaps="false"
                android:textColor="@color/branco"
                android:textSize="13sp"
                app:backgroundTint="@color/verde_escuro_principal"
                app:cornerRadius="19dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textoTituloQuiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_bold"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/areaAcaoQuiz"
            app:layout_constraintStart_toEndOf="@id/fundoIconeQuiz"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textoCategoriaQuiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/fundo_selo_conteudo_home"
            android:fontFamily="@font/nunito_bold"
            android:includeFontPadding="false"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="11.5sp"
            app:layout_constraintStart_toStartOf="@id/textoTituloQuiz"
            app:layout_constraintTop_toBottomOf="@id/textoTituloQuiz" />

        <LinearLayout
            android:id="@+id/metadadosQuiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/textoTituloQuiz"
            app:layout_constraintTop_toBottomOf="@id/textoCategoriaQuiz">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/quantidade_perguntas"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/cinza_secundario_home" />

            <TextView
                android:id="@+id/textoPerguntasQuiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito_regular"
                android:includeFontPadding="false"
                android:textColor="@color/cinza_secundario_home"
                android:textSize="12.5sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="11dp"
                android:contentDescription="@string/duracao_quiz"
                android:src="@drawable/icon_relogio"
                app:tint="@color/cinza_secundario_home" />

            <TextView
                android:id="@+id/textoDuracaoQuiz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/nunito_regular"
                android:includeFontPadding="false"
                android:textColor="@color/cinza_secundario_home"
                android:textSize="12.5sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
