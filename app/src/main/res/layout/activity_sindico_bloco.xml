<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizSindicoBloco"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/voltarSindicoBloco"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voltar aos blocos"
        android:padding="13dp"
        android:src="@drawable/sindico_voltar" />

    <TextView
        android:id="@+id/tituloSindicoBloco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/nunito_bold"
        android:textColor="@color/verde_escuro_principal"
        android:textSize="22sp" />

    <EditText
        android:id="@+id/buscaSindicoBloco"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/sindico_campo"
        android:drawableStart="@drawable/buscar_icon"
        android:drawablePadding="8dp"
        android:hint="Buscar unidade..."
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/preto_texto_home"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/listaSindicoApartamentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/adicionarApartamentoSindico"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/sindico_status_concluida"
        android:clickable="true"
        android:contentDescription="Adicionar unidade"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/sindico_unidades_adicionar"
            app:tint="@color/branco" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/nunito_bold"
            android:text="Adicionar unidade"
            android:textColor="@color/branco"
            android:textSize="14sp" />
    </LinearLayout>

    <com.example.ecociente.views.SindicoBottomBar
        android:id="@+id/barraInferiorSindico"
        android:layout_width="match_parent"
        android:layout_height="86dp" />
</LinearLayout>
