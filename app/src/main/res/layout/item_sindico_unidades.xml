<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="54dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">
    <ImageView
        android:id="@+id/iconeItemUnidades"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/sindico_nav_mascote_fundo"
        android:contentDescription="@null"
        android:padding="6dp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/nomeItemUnidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/nunito_bold"
            android:maxLines="1"
            android:textColor="@color/preto_texto_home"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/detalheItemUnidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/cinza_texto_home"
            android:textSize="10sp" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/editarItemUnidades"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="13dp"
        android:src="@drawable/sindico_unidades_editar" />
    <ImageButton
        android:id="@+id/excluirItemUnidades"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="13dp"
        android:src="@drawable/ic_excluir" />
</LinearLayout>
