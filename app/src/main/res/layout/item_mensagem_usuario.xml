<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:gravity="center_vertical|end"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/textoMensagemUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:background="@drawable/fundo_bolha_usuario"
        android:fontFamily="@font/nunito_regular"
        android:maxWidth="255dp"
        android:textColor="@color/black"
        android:textSize="12sp" />

    <ImageView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/fundo_icone_chat"
        android:contentDescription="@string/chat_avatar_usuario"
        android:padding="9dp"
        android:src="@drawable/ic_usuario_chat" />
</LinearLayout>
