<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:gravity="top"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/fundo_icone_chat"
        android:contentDescription="@string/chat_avatar_eko"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/eko_avatar_conversa" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="30dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="7dp"
        app:cardElevation="4dp">

        <TextView
            android:id="@+id/textoMensagemEko"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fundo_bolha_eko"
            android:fontFamily="@font/nunito_regular"
            android:lineSpacingExtra="1dp"
            android:textColor="@color/black"
            android:textSize="12sp" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
