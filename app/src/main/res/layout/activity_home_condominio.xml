<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizHomeCondominio"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".views.CondominioHomeActivity">

    <FrameLayout
        android:id="@+id/cabecalhoHomeCondominio"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="136dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_ecociente"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_ecociente"
            app:tint="@color/verde_escuro_principal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/botaoNotificacoesCondominio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/notificacoes"
                android:padding="2dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_notificacoes" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="7dp"
                style="@style/AvatarCabecalho">

                <ImageView
                    android:id="@+id/imagemPerfilCondominio"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/foto_perfil"
                    style="@style/AvatarCabecalho.Imagem" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/espaco_barra_navegacao"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="@id/barraNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cabecalhoHomeCondominio">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/blocoSaudacaoCondominio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="26dp"
                android:paddingEnd="26dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textoSaudacaoCondominio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:textColor="@color/rosa_ecociente"
                        android:textSize="22sp"
                        tools:text="Olá, Julio!" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/home_condominio_lema"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="14sp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ilustracao_coleta_reciclavel" />

            </LinearLayout>

            <include layout="@layout/card_pontos" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSemanaColetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="@dimen/raio_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinza_borda_clara_home"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_calendario"
                            app:tint="@color/verde_escuro_principal" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/calendario_da_semana"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/botaoVerCalendarioCompleto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:fontFamily="@font/nunito_semibold"
                            android:padding="4dp"
                            android:text="@string/ver_calendario_completo"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="11sp" />

                    </LinearLayout>

                    <com.example.ecociente.ui.SemanaColetasView
                        android:id="@+id/semanaColetas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:id="@+id/textoErroSemana"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/nunito_regular"
                        android:gravity="center"
                        android:text="@string/semana_erro"
                        android:textColor="@color/cinza_texto_auxiliar"
                        android:textSize="11sp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="@dimen/raio_card"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinza_borda_clara_home"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_trofeu" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_bold"
                            android:text="@string/ranking_do_morador"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_seta_direita" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textoEstadoRankingHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/ranking_carregando"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:baselineAligned="false"
                        android:id="@+id/podioHome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/avatarSegundoHome"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/sindico_ranking_avatar_segundo"
                                android:fontFamily="@font/nunito_bold"
                                android:gravity="center"
                                android:textColor="@color/preto_texto_home"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="70dp"
                                android:layout_height="57dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/sindico_ranking_podio_lateral"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="@string/sindico_2o"
                                    android:textColor="@color/preto_texto_home"
                                    android:textSize="18sp" />

                                <TextView
                                    android:id="@+id/pontosSegundoHome"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_regular"
                                    android:textColor="@color/cinza_texto_home"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="0dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/avatarPrimeiroHome"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:background="@drawable/sindico_ranking_avatar_primeiro"
                                android:fontFamily="@font/nunito_bold"
                                android:gravity="center"
                                android:textColor="@color/preto_texto_home"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="70dp"
                                android:layout_height="63dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/sindico_ranking_podio_primeiro"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="@string/sindico_1o"
                                    android:textColor="@color/branco"
                                    android:textSize="18sp" />

                                <TextView
                                    android:id="@+id/pontosPrimeiroHome"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:textColor="@color/branco"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="45dp"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/avatarTerceiroHome"
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:background="@drawable/sindico_ranking_avatar_terceiro"
                                android:fontFamily="@font/nunito_bold"
                                android:gravity="center"
                                android:textColor="@color/preto_texto_home"
                                android:textSize="14sp" />

                            <LinearLayout
                                android:layout_width="70dp"
                                android:layout_height="57dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/sindico_ranking_podio_lateral"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_bold"
                                    android:text="@string/sindico_3o"
                                    android:textColor="@color/preto_texto_home"
                                    android:textSize="18sp" />

                                <TextView
                                    android:id="@+id/pontosTerceiroHome"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/nunito_regular"
                                    android:textColor="@color/cinza_texto_home"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/cabecalhoConteudosCondominio"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:contentDescription="@string/icone_conteudos"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_guia_cinza" app:tint="@color/verde_escuro_principal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/conteudos_para_voce"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="15sp" />

            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="4dp">

                    <include
                        layout="@layout/item_conteudo_home_guia"
                        android:layout_width="158dp"
                        android:layout_height="212dp"
                        android:layout_marginEnd="12dp" />

                    <include
                        layout="@layout/item_conteudo_home_dica"
                        android:layout_width="158dp"
                        android:layout_height="212dp"
                        android:layout_marginEnd="12dp" />

                    <include
                        layout="@layout/item_conteudo_home_artigo"
                        android:layout_width="158dp"
                        android:layout_height="212dp" />

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
