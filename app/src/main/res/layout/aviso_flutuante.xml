<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/branco"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/cinza_borda_card_perfil"
    app:strokeWidth="1dp">

    <TextView
        android:id="@+id/textoAvisoFlutuante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="22dp"
        android:paddingBottom="14dp"
        android:fontFamily="@font/nunito_semibold"
        android:textColor="@color/verde_escuro_principal"
        android:textSize="14sp"
        android:gravity="center_vertical"
        android:drawablePadding="12dp"
        app:drawableStartCompat="@drawable/ic_info_circulo" />

</com.google.android.material.card.MaterialCardView>
