<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/CartaoComBorda"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="18dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="18dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/iniciaisFeed"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/fundo_avatar_iniciais"
                android:fontFamily="@font/nunito_bold"
                android:gravity="center"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/autorFeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_bold"
                android:maxLines="1"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/quandoFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_regular"
                android:textColor="@color/cinza_texto_auxiliar"
                android:textSize="11sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/fotoFeed"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/cinza_fundo_imagem_home"
            android:contentDescription="@string/feed_foto_descarte"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:id="@+id/categoriaFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_chip_tipo_coleta"
                android:fontFamily="@font/nunito_semibold"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/statusFeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_semibold"
                android:textColor="@color/cinza_texto_home"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
