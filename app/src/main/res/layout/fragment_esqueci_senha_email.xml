<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:paddingStart="32dp"
    android:paddingTop="90dp"
    android:paddingEnd="32dp"
    tools:context=".controller.EsqueciSenhaEmailFragment">

    <TextView
        android:id="@+id/tituloEsqueciSenha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/nunito_semibold"
        android:text="Esqueceu a senha"
        android:textColor="@color/verde_escuro_principal"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtituloEsqueciSenha"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/nunito_medium"
        android:text="Entre com o endereço de email associado com a sua conta."
        android:textColor="@color/cinza_escuro_textos"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloEsqueciSenha" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/containerEmail"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtituloEsqueciSenha"
        app:strokeColor="@color/verde_escuro_principal"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Ícone email"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_email" />

            <EditText
                android:id="@+id/campoEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:autofillHints="emailAddress"
                android:background="@android:color/transparent"
                android:fontFamily="@font/nunito_medium"
                android:hint="Email"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                android:padding="0dp"
                android:textColor="@color/verde_escuro_principal"
                android:textColorHint="@color/cinza_escuro_textos"
                android:textSize="12sp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoEnviarCodigo"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/nunito_semibold"
        android:text="Enviar código"
        android:textAllCaps="false"
        android:textColor="@color/branco"
        android:textSize="16sp"
        app:backgroundTint="@color/verde_escuro_principal"
        app:cornerRadius="12dp"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/containerEmail" />

</androidx.constraintlayout.widget.ConstraintLayout>
