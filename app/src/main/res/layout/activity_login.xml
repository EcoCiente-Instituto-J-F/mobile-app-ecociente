<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_escuro_principal"
    tools:context=".controller.Login">

    <ImageView
        android:id="@+id/imagemLogo"
        android:layout_width="190dp"
        android:layout_height="72dp"
        android:layout_marginTop="30dp"
        android:adjustViewBounds="true"
        android:contentDescription="Logo EcoCiente"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_ecociente"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/painelLogin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="-35dp"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="38dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imagemLogo">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="700dp"
                android:paddingStart="32dp"
                android:paddingTop="12dp"
                android:paddingEnd="32dp"
                android:paddingBottom="35dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/seletorLoginCadastro"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginTop="18dp"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/verde_escuro_principal"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:padding="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/abaLogin"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_medium"
                            android:text="Login"
                            android:textAllCaps="false"
                            android:textColor="@color/branco"
                            android:textSize="11sp"
                            app:backgroundTint="@color/verde_escuro_principal"
                            app:cornerRadius="8dp"
                            app:elevation="0dp" />

                        <TextView
                            android:id="@+id/abaCadastro"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_medium"
                            android:gravity="center"
                            android:text="Cadastrar-se"
                            android:textColor="@color/verde_escuro_principal"
                            android:textSize="11sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tituloLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="58dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="Login"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="25sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/seletorLoginCadastro" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/containerEmail"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="34dp"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/verde_escuro_principal"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tituloLogin">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:id="@+id/iconeEmail"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Ícone email"
                            android:scaleType="fitCenter"
                            android:src="@drawable/icon_email" />

                        <EditText
                            android:id="@+id/campoEmail"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:autofillHints="emailAddress"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/nunito_medium"
                            android:hint="Email"
                            android:imeOptions="actionNext"
                            android:inputType="textEmailAddress"
                            android:padding="0dp"
                            android:textColor="@color/verde_escuro_principal"
                            android:textColorHint="@color/cinza_escuro_textos"
                            android:textSize="12sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/containerSenha"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/verde_escuro_principal"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/containerEmail">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingStart="12dp"
                        android:paddingEnd="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@id/iconeOlhoSenha"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iconeSenha"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="Ícone senha"
                                android:scaleType="fitCenter"
                                android:src="@drawable/icon_senha" />

                            <EditText
                                android:id="@+id/campoSenha"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:autofillHints="password"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/nunito_medium"
                                android:hint="Senha"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:padding="0dp"
                                android:textColor="@color/verde_escuro_principal"
                                android:textColorHint="@color/cinza_escuro_textos"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:id="@+id/iconeOlhoSenha"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="Mostrar senha"
                            android:focusable="true"
                            android:padding="9dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/icon_olho_fechado" />

                    </RelativeLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/textoEsqueceuSenha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/nunito_medium"
                    android:text="Esqueceu a senha?"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="9sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/containerSenha" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botaoLogin"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="38dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:text="Login"
                    android:textAllCaps="false"
                    android:textColor="@color/branco"
                    android:textSize="17sp"
                    app:backgroundTint="@color/verde_escuro_principal"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textoEsqueceuSenha" />

                <LinearLayout
                    android:id="@+id/divisorOu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/botaoLogin">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D9D9D9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:fontFamily="@font/nunito_medium"
                        android:text="OU"
                        android:textColor="@color/cinza_escuro_textos"
                        android:textSize="10sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#D9D9D9" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/containerRedesSociais"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.497"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divisorOu"
                    app:layout_constraintVertical_bias="0.0">

                    <ImageView
                        android:id="@+id/imagemGoogle"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Google"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_google" />

                    <ImageView
                        android:id="@+id/imagemFacebook"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="44dp"
                        android:contentDescription="Facebook"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_facebook" />

                    <ImageView
                        android:id="@+id/imagemApple"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="44dp"
                        android:contentDescription="Apple"
                        android:scaleType="fitCenter"
                        android:src="@drawable/icon_apple" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>