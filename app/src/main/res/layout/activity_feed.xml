<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizFeed"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".views.FeedActivity">

    <TextView
        android:id="@+id/tituloFeed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="26dp"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/feed"
        android:textColor="@color/rosa_ecociente"
        android:textSize="22sp"
        app:layout_constraintEnd_toStartOf="@id/textoMeusDescartes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textoMeusDescartes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="26dp"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="@font/nunito_semibold"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/feed_meus_descartes"
        android:textColor="@color/verde_escuro_principal"
        android:textSize="13sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tituloFeed"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/subtituloFeed"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:fontFamily="@font/nunito_regular"
        android:text="@string/feed_subtitulo"
        android:textColor="@color/cinza_texto_home"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloFeed" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/espaco_barra_navegacao"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="@id/barraNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtituloFeed">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/listaFeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/botaoRegistrarDescarte"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="88dp"
        android:contentDescription="@string/feed_registrar_descarte"
        android:src="@drawable/ic_adicionar"
        app:backgroundTint="@color/verde_escuro_principal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.EcoCiente.Circulo"
        app:tint="@color/branco" />

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
