<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/raizQuizUsuarioComum"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rolagemQuizzes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/barraNavegacaoQuiz"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="22dp">

            <!-- ===================================================== -->
            <!-- CABEÇALHO: MESMAS MARGENS/POSIÇÃO DA HOME            -->
            <!-- ===================================================== -->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cabecalhoQuiz"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp">

                <ImageView
                    android:id="@+id/botaoVoltarQuiz"
                    android:layout_width="38dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/voltar"
                    android:focusable="true"
                    android:paddingStart="3dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/ic_voltar"
                    android:translationY="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/verde_escuro_principal" />

                <LinearLayout
                    android:id="@+id/blocoTitulosQuiz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:translationY="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/acoesCabecalhoQuiz"
                    app:layout_constraintStart_toEndOf="@id/botaoVoltarQuiz"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/textoTituloQuizTela"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_regular"
                        android:includeFontPadding="false"
                        android:text="@string/quizzes"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/textoSubtituloQuizTela"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/subtitulo_quizzes"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- Mesmo conjunto sino + perfil utilizado na Home -->
                <LinearLayout
                    android:id="@+id/acoesCabecalhoQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:translationY="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/botaoNotificacoesQuiz"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/notificacoes"
                        android:focusable="true"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/icon_notificacoes" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="7dp"
                        app:cardBackgroundColor="@color/cinza_fundo_imagem_home"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imagemPerfilQuiz"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/foto_perfil"
                            android:padding="5dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_perfil_usuario" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ===================================================== -->
            <!-- PESQUISA                                              -->
            <!-- ===================================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPesquisaQuiz"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/cinza_borda_home"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <!-- Placeholder: você pode substituir pela imagem final depois -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/buscar"
                        android:scaleType="centerInside"
                        android:src="@drawable/buscar_icon" />

                    <EditText
                        android:id="@+id/campoPesquisaQuiz"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/nunito_regular"
                        android:hint="@string/pesquise"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/preto_texto_home"
                        android:textColorHint="@color/cinza_secundario_home"
                        android:textSize="16sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===================================================== -->
            <!-- QUANTIDADE / FILTRO                                   -->
            <!-- ===================================================== -->

            <LinearLayout
                android:id="@+id/linhaResumoQuiz"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textoQuantidadeQuizzes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_regular"
                    android:text="@string/seis_quizzes_disponiveis"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="15sp" />

                <!-- Placeholder: troque pelo asset final quando quiser -->
                <ImageView
                    android:id="@+id/botaoFiltrosQuiz"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/filtros"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@color/cinza_secundario_home" />

            </LinearLayout>

            <!-- ===================================================== -->
            <!-- LISTA DE QUIZZES                                      -->
            <!-- ===================================================== -->

            <LinearLayout
                android:id="@+id/listaQuizzes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="18dp"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- ===================================================== -->
    <!-- BARRA DE NAVEGAÇÃO: MESMA GEOMETRIA DA HOME           -->
    <!-- ===================================================== -->

    <FrameLayout
        android:id="@+id/barraNavegacaoQuiz"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/fundo_barra_navegacao_home"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/indicadorNavegacaoQuiz"
            android:layout_width="26dp"
            android:layout_height="4dp"
            android:layout_gravity="top|start"
            android:background="@drawable/fundo_indicador_navegacao_ativo"
            android:translationY="-1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="5">

            <!-- HOME -->
            <LinearLayout
                android:id="@+id/botaoNavHomeQuiz"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:translationX="5dp">

                <ImageView
                    android:id="@+id/iconeNavHomeQuiz"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/home"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_home_verde" />

                <TextView
                    android:id="@+id/textoNavHomeQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/nunito_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/home"
                    android:textColor="@color/verde_escuro_principal"
                    android:textSize="8.5sp" />

            </LinearLayout>

            <!-- GUIA -->
            <LinearLayout
                android:id="@+id/botaoNavGuiaQuiz"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:translationX="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/guia"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_guia_cinza" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/nunito_regular"
                    android:includeFontPadding="false"
                    android:text="@string/guia"
                    android:textColor="@color/cinza_secundario_home"
                    android:textSize="8.5sp" />

            </LinearLayout>

            <!-- ESPAÇO DO ASSISTENTE -->
            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- QUIZ -->
            <LinearLayout
                android:id="@+id/botaoNavQuizQuiz"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:translationX="-2dp">

                <ImageView
                    android:id="@+id/iconeNavQuizQuiz"
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@string/quiz"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_quiz_cinza" />

                <TextView
                    android:id="@+id/textoNavQuizQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_regular"
                    android:includeFontPadding="false"
                    android:text="@string/quiz"
                    android:textColor="@color/cinza_secundario_home"
                    android:textSize="8.5sp" />

            </LinearLayout>

            <!-- PERFIL -->
            <LinearLayout
                android:id="@+id/botaoNavPerfilQuiz"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:translationX="-5dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/perfil"
                    android:scaleType="centerInside"
                    android:src="@drawable/icon_perfil_cinza" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/nunito_regular"
                    android:includeFontPadding="false"
                    android:text="@string/perfil"
                    android:textColor="@color/cinza_secundario_home"
                    android:textSize="8.5sp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- MESMO ASSISTENTE CENTRAL DA HOME -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/botaoNavAssistenteQuiz"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="0dp"
        android:stateListAnimator="@null"
        android:translationY="-17dp"
        app:cardBackgroundColor="@color/verde_claro_ecociente"
        app:cardCornerRadius="34dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/barraNavegacaoQuiz"
        app:strokeWidth="0dp">

        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:contentDescription="@string/assistente"
            android:scaleType="centerInside"
            android:src="@drawable/icon_chatbot_verde"
            android:tintMode="src_in"
            app:tint="@color/verde_escuro_principal" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>