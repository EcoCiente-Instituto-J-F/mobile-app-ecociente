<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/raizQuizUsuarioComum"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rolagemQuizzes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="72dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="@id/barraNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="22dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cabecalhoQuiz"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp">

                <ImageView
                    android:id="@+id/botaoVoltarQuiz"
                    android:layout_width="38dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/voltar"
                    android:focusable="true"
                    android:paddingStart="3dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="11dp"
                    android:src="@drawable/ic_voltar"
                    android:translationY="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/verde_escuro_principal" />

                <LinearLayout
                    android:id="@+id/blocoTitulosQuiz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical"
                    android:translationY="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/acoesCabecalhoQuiz"
                    app:layout_constraintStart_toEndOf="@id/botaoVoltarQuiz"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/textoTituloQuizTela"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_regular"
                        android:includeFontPadding="false"
                        android:text="@string/quizzes"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/textoSubtituloQuizTela"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/nunito_regular"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:text="@string/subtitulo_quizzes"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/acoesCabecalhoQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:translationY="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/botaoNotificacoesQuiz"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/notificacoes"
                        android:focusable="true"
                        android:padding="2dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/icon_notificacoes" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="7dp"
                        app:cardBackgroundColor="@color/cinza_fundo_imagem_home"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/imagemPerfilQuiz"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/foto_perfil"
                            android:padding="5dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_perfil_usuario" />

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPesquisaQuiz"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/cinza_borda_home"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/buscar"
                        android:scaleType="centerInside"
                        android:src="@drawable/buscar_icon" />

                    <EditText
                        android:id="@+id/campoPesquisaQuiz"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/nunito_regular"
                        android:hint="@string/pesquise"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/preto_texto_home"
                        android:textColorHint="@color/cinza_secundario_home"
                        android:textSize="16sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/linhaResumoQuiz"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textoQuantidadeQuizzes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/nunito_regular"
                    android:text="@string/seis_quizzes_disponiveis"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/botaoFiltrosQuiz"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/filtros"
                    android:padding="9dp"
                    android:src="@android:drawable/ic_menu_manage"
                    app:tint="@color/cinza_secundario_home" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/listaQuizzes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="18dp"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>