<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/sindico_dialog_solicitacao"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/voltarSolicitacao"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Fechar solicitação de coleta"
                android:padding="14dp"
                android:src="@drawable/sindico_voltar" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/sindico_building_campo" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/nunito_bold"
                android:text="Solicitação de coleta"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="20sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="62dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:fontFamily="@font/nunito_regular"
                android:text="Nome da cooperativa"
                android:textColor="@color/cinza_texto_home"
                android:textSize="13sp" />
            <ImageView
                android:layout_width="113dp"
                android:layout_height="60dp"
                android:layout_gravity="end|top"
                android:contentDescription="Caminhão de reciclagem"
                android:scaleType="centerCrop"
                android:src="@drawable/sindico_caminhao_coleta" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/sindico_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/sindico_building_campo" />
            <TextView
                android:id="@+id/nomeSolicitacao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/nunito_regular"
                android:text="Cooperativa Recicla Mais"
                android:textColor="@color/preto_texto_home"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/nunito_regular"
            android:labelFor="@id/enderecoSolicitacao"
            android:text="Endereço"
            android:textColor="@color/cinza_texto_home"
            android:textSize="13sp" />
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/sindico_campo">
            <EditText
                android:id="@+id/enderecoSolicitacao"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:fontFamily="@font/nunito_regular"
                android:hint="Endereço da coleta"
                android:inputType="textPostalAddress"
                android:paddingStart="50dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:text="Rua das Hortênsias, 123 - Jardim das Flores"
                android:textColor="@color/preto_texto_home"
                android:textColorHint="@color/cinza_texto_home"
                android:textSize="12sp" />
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_localizacao_chat" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_regular"
                    android:text="Data"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="13sp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/sindico_campo">
                    <TextView
                        android:id="@+id/dataSolicitacao"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:contentDescription="Escolher data da coleta"
                        android:focusable="true"
                        android:fontFamily="@font/nunito_regular"
                        android:gravity="center_vertical"
                        android:paddingStart="42dp"
                        android:paddingEnd="4dp"
                        android:text="12/09/2026"
                        android:textColor="@color/preto_texto_home"
                        android:textSize="12sp" />
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="9dp"
                        android:contentDescription="@null"
                        android:src="@drawable/sindico_calendario" />
                </FrameLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_regular"
                    android:text="Horário"
                    android:textColor="@color/cinza_texto_home"
                    android:textSize="13sp" />
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/sindico_campo">
                    <TextView
                        android:id="@+id/horaSolicitacao"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:contentDescription="Escolher horário da coleta"
                        android:focusable="true"
                        android:fontFamily="@font/nunito_regular"
                        android:gravity="center_vertical"
                        android:paddingStart="40dp"
                        android:paddingEnd="4dp"
                        android:text="12:30"
                        android:textColor="@color/preto_texto_home"
                        android:textSize="12sp" />
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/sindico_horario" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/nunito_regular"
            android:text="A coleta será recorrente?"
            android:textColor="@color/cinza_texto_home"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <Button
                android:id="@+id/recorrenciaSim"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/verde_escuro_principal"
                android:text="Sim"
                android:textAllCaps="false"
                android:textColor="@color/branco" />
            <Button
                android:id="@+id/recorrenciaNao"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:backgroundTint="@color/rosa_ecociente"
                android:text="Não"
                android:textAllCaps="false"
                android:textColor="@color/branco" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
