<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cabecalhoInformacoesPessoais"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/verde_escuro_principal"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/botaoVoltarInformacoesPessoais"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/voltar"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_voltar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/branco" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/containerAvatarInformacoesPessoais"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/botaoVoltarInformacoesPessoais">

                    <ImageView
                        android:id="@+id/imagemAvatarInformacoesPessoais"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/foto_perfil"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_perfil_usuario" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/textoNomeInformacoesPessoais"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/nunito_bold"
                    android:textColor="@color/branco"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/containerAvatarInformacoesPessoais"
                    tools:text="Julio Cesar" />

                <TextView
                    android:id="@+id/textoEmailInformacoesPessoais"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.8"
                    android:fontFamily="@font/nunito_regular"
                    android:textColor="@color/branco"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textoNomeInformacoesPessoais"
                    tools:text="julio.cesar@gmail.com" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tituloInformacoesPessoais"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/informacoes_pessoais"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cabecalhoInformacoesPessoais" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/containerCamposPessoais"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/branco"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tituloInformacoesPessoais"
            app:strokeColor="@color/cinza_borda_card_perfil"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/linhaCampoNome"
                    layout="@layout/item_campo_pessoal" />

                <View style="@style/DivisorCampoPessoal" />

                <include
                    android:id="@+id/linhaCampoEmail"
                    layout="@layout/item_campo_pessoal" />

                <View style="@style/DivisorCampoPessoal" />

                <include
                    android:id="@+id/linhaCampoTelefone"
                    layout="@layout/item_campo_pessoal" />

                <View style="@style/DivisorCampoPessoal" />

                <include
                    android:id="@+id/linhaCampoEndereco"
                    layout="@layout/item_campo_pessoal" />

                <View style="@style/DivisorCampoPessoal" />

                <include
                    android:id="@+id/linhaCampoCpf"
                    layout="@layout/item_campo_pessoal" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
