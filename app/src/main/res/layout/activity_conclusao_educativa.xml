<?xml version='1.0' encoding='UTF-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/raizConclusaoEducativa" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/verde_escuro_principal">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:paddingStart="25dp" android:paddingEnd="25dp" android:paddingBottom="16dp">

        <ImageView android:id="@+id/logoTopoConclusaoEducativa" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="22dp" android:adjustViewBounds="true" android:contentDescription="@string/conclusao_educativa_logo_ecociente" android:scaleType="fitCenter" android:src="@drawable/logo_ecociente"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical">

            <TextView android:id="@+id/etiquetaConclusaoEducativa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="@string/conclusao_educativa_missao_cumprida" android:fontFamily="@font/nunito_extrabold" android:textColor="#B5E8C9" android:textSize="14sp"/>

            <ImageView android:id="@+id/ekoConclusaoEducativa" android:layout_width="match_parent" android:layout_height="275dp" android:layout_marginTop="16dp" android:contentDescription="@string/conclusao_educativa_eko_comemorando" android:scaleType="fitCenter" android:src="@drawable/mascote_eko"/>

            <TextView android:id="@+id/tituloConclusaoEducativa" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/conclusao_educativa_voce_concluiu_a_aula" android:fontFamily="@font/nunito_extrabold" android:textColor="@color/branco" android:textSize="29sp"/>

            <TextView android:id="@+id/subtituloConclusaoEducativa" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:lineSpacingExtra="3dp" android:text="@string/conclusao_educativa_cada_aprendizado_aproxima_a_gente_de_u" android:fontFamily="@font/nunito_regular" android:textColor="#E5F4EA" android:textSize="16sp"/>

            </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/botaoVoltarConclusaoEducativa" android:layout_width="match_parent" android:layout_height="60dp" android:text="@string/conclusao_educativa_continuar_aprendendo" android:textAllCaps="false" android:fontFamily="@font/nunito_extrabold" android:textSize="17sp" android:textColor="@color/verde_escuro_principal" app:backgroundTint="@color/branco" app:cornerRadius="16dp"/>
    </LinearLayout>

    </FrameLayout>
