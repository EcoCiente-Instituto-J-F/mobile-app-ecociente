<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:contentDescription="@string/chat_eko_digitando"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/fundo_icone_chat"
        android:contentDescription="@null"
        android:padding="2dp"
        android:scaleType="fitCenter"
        android:src="@drawable/mascote_eko" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:cardBackgroundColor="@color/verde_fundo_card_claro"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <View
                android:id="@+id/pontoDigitacaoEko1"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/fundo_ponto_digitacao_eko" />

            <View
                android:id="@+id/pontoDigitacaoEko2"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/fundo_ponto_digitacao_eko" />

            <View
                android:id="@+id/pontoDigitacaoEko3"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="9dp"
                android:background="@drawable/fundo_ponto_digitacao_eko" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
