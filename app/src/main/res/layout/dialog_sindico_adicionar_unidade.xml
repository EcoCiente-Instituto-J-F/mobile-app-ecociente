<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/sindico_dialog_avaliacao">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/voltarFormularioUnidade"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sindico_fechar_formulario"
            android:padding="13dp"
            android:src="@drawable/ic_voltar"
        android:scaleType="centerInside" />

        <TextView
            android:id="@+id/tituloFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/nunito_bold"
            android:text="@string/sindico_adicionar_unidade"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="23sp"
            android:gravity="center_vertical"
            android:drawablePadding="12dp"
            app:drawableStartCompat="@drawable/ic_predio_28dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:labelFor="@id/numeroFormularioUnidade"
            android:text="@string/sindico_numero_do_apartamento"
            android:textColor="@color/cinza_texto_home"
            android:textSize="14sp" />
        <EditText
            android:importantForAutofill="no"
            android:id="@+id/numeroFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/sindico_campo"
            android:drawableStart="@drawable/ic_predio"
            android:drawablePadding="8dp"
            android:inputType="textCapWords"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/preto_texto_home"
            android:textSize="13sp" />

        <TextView
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:labelFor="@id/moradorFormularioUnidade"
            android:text="@string/sindico_nome_do_morador"
            android:textColor="@color/cinza_texto_home"
            android:textSize="14sp" />
        <EditText
            android:importantForAutofill="no"
            android:id="@+id/moradorFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/sindico_campo"
            android:drawableStart="@drawable/ic_perfil_usuario"
            android:drawablePadding="8dp"
            android:hint="@string/sindico_maria_clara"
            android:inputType="textPersonName"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/preto_texto_home"
            android:textSize="13sp" />

        <TextView
            android:importantForAutofill="no"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:labelFor="@id/telefoneFormularioUnidade"
            android:text="@string/sindico_telefone_do_morador"
            android:textColor="@color/cinza_texto_home"
            android:textSize="14sp" />
        <EditText
            android:importantForAutofill="no"
            android:id="@+id/telefoneFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/sindico_campo"
            android:drawableStart="@drawable/ic_telefone_perfil"
            android:drawablePadding="8dp"
            android:hint="@string/sindico_11_95376_2717"
            android:inputType="phone"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/preto_texto_home"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/enviarFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/sindico_status_concluida"
            android:clickable="true"
            android:contentDescription="@string/sindico_enviar_unidade"
            android:focusable="true"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:text="@string/sindico_enviar"
            android:textColor="@color/branco"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
