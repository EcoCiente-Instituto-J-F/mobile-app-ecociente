<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="@drawable/sindico_dialog_avaliacao">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="12dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <ImageButton
            android:id="@+id/voltarFormularioUnidade"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fechar formulário"
            android:padding="13dp"
            android:src="@drawable/sindico_voltar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/sindico_building_campo" />
            <TextView
                android:id="@+id/tituloFormularioUnidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/nunito_bold"
                android:text="Adicionar unidade"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="23sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:labelFor="@id/numeroFormularioUnidade"
            android:text="Número do apartamento"
            android:textColor="@color/cinza_texto_home"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/numeroFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/sindico_campo"
            android:drawableStart="@drawable/sindico_building_campo"
            android:drawablePadding="8dp"
            android:hint="Apto 120"
            android:inputType="textCapWords"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/preto_texto_home"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:labelFor="@id/moradorFormularioUnidade"
            android:text="Nome do morador"
            android:textColor="@color/cinza_texto_home"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/moradorFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/sindico_campo"
            android:drawableStart="@drawable/ic_perfil_usuario"
            android:drawablePadding="8dp"
            android:hint="Maria Clara"
            android:inputType="textPersonName"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/preto_texto_home"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:labelFor="@id/telefoneFormularioUnidade"
            android:text="Telefone do morador"
            android:textColor="@color/cinza_texto_home"
            android:textSize="14sp" />
        <EditText
            android:id="@+id/telefoneFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/sindico_campo"
            android:drawableStart="@drawable/ic_telefone_perfil"
            android:drawablePadding="8dp"
            android:hint="(11) 95376-2717"
            android:inputType="phone"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/preto_texto_home"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/enviarFormularioUnidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/sindico_status_concluida"
            android:clickable="true"
            android:contentDescription="Enviar unidade"
            android:focusable="true"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:text="Enviar"
            android:textColor="@color/branco"
            android:textSize="18sp" />
    </LinearLayout>
</ScrollView>
