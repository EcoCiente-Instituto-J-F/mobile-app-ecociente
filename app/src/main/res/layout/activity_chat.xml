<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_escuro_principal"
    android:clipToPadding="false"
    tools:context=".views.ChatActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/estadoInicialChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/verde_escuro_principal"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="92dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="20dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="198dp"
                android:layout_height="58dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/logo_ecociente"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_ecociente" />

            <FrameLayout
                android:layout_width="146dp"
                android:layout_height="146dp"
                android:layout_marginTop="73dp"
                android:background="@drawable/fundo_avatar_chat">

                <ImageView
                    android:layout_width="136dp"
                    android:layout_height="136dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/chat_avatar_eko"
                    android:scaleType="fitCenter"
                    android:src="@drawable/mascote_eko" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/nunito_semibold"
                android:gravity="center"
                android:text="@string/chat_titulo_inicial"
                android:textColor="@color/branco"
                android:textSize="23sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/nunito_regular"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:text="@string/chat_descricao_inicial"
                android:textColor="@color/branco"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="18dp"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/opcaoMaterialReciclavel"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/ripple_branco_chat"
                    app:strokeColor="@color/branco"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/fundo_icone_chat"
                            android:padding="9dp"
                            android:src="@drawable/icone_material_chat" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/chat_opcao_material"
                            android:textColor="@color/branco"
                            android:textSize="14sp" />

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_seta_chat" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/opcaoComoReciclar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/ripple_branco_chat"
                    app:strokeColor="@color/branco"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/fundo_icone_chat"
                            android:padding="8dp"
                            android:src="@drawable/icone_reciclar_chat" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/chat_opcao_reciclar"
                            android:textColor="@color/branco"
                            android:textSize="14sp" />

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_seta_chat" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/opcaoCooperativaProxima"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp"
                    app:rippleColor="@color/ripple_branco_chat"
                    app:strokeColor="@color/branco"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/fundo_icone_chat"
                            android:padding="8dp"
                            android:src="@drawable/icone_localizacao_chat" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/nunito_regular"
                            android:text="@string/chat_opcao_cooperativa"
                            android:textColor="@color/branco"
                            android:textSize="14sp" />

                        <ImageView
                            android:importantForAccessibility="no"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_seta_chat" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/botaoSairChat"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/chat_voltar"
        android:padding="13dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_voltar"
        app:tint="@color/branco" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/estadoConversaChat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/branco"
        android:visibility="gone"
        tools:visibility="gone">

        <ImageView
            android:importantForAccessibility="no"
            android:id="@+id/fundoCabecalhoChat"
            android:layout_width="0dp"
            android:layout_height="108dp"
            android:elevation="4dp"
            android:scaleType="fitXY"
            android:src="@drawable/fundo_cabecalho_chat"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/botaoVoltarChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/chat_voltar"
            android:elevation="6dp"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_voltar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/branco" />

        <TextView
            android:id="@+id/tituloCabecalhoChat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:elevation="6dp"
            android:fontFamily="@font/nunito_semibold"
            android:text="@string/chat_titulo_conversa"
            android:textColor="@color/branco"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/rolagemMensagensChat"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingStart="28dp"
            android:paddingTop="134dp"
            android:paddingEnd="28dp"
            android:paddingBottom="100dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/containerMensagensChat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/painelEntradaChat"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/branco"
        app:cardCornerRadius="10dp"
        app:cardElevation="5dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <EditText
                android:importantForAutofill="no"
                android:id="@+id/campoMensagemChat"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:background="@drawable/fundo_campo_chat"
                android:fontFamily="@font/nunito_regular"
                android:hint="@string/chat_hint_mensagem"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textColorHint="@color/cinza_hint_chat"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/botaoEnviarChat"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/botaoEnviarChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/fundo_botao_enviar_chat"
                android:contentDescription="@string/chat_enviar"
                android:padding="10dp"
                android:src="@drawable/ic_enviar_chat"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
