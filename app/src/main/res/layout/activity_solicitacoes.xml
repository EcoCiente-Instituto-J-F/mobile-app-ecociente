<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizSolicitacoes"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".views.SolicitacoesActivity">

    <TextView
        android:id="@+id/tituloSolicitacoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="22dp"
        android:fontFamily="@font/nunito_bold"
        android:text="@string/solicitacoes"
        android:textColor="@color/rosa_ecociente"
        android:textSize="22sp"
        app:layout_constraintEnd_toStartOf="@id/botaoNovaColetaSolicitacoes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoNovaColetaSolicitacoes"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="18dp"
        android:fontFamily="@font/nunito_semibold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="14dp"
        android:paddingBottom="0dp"
        android:text="@string/nova_coleta"
        android:textAllCaps="false"
        android:textSize="12sp"
        app:backgroundTint="@color/verde_escuro_principal"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_adicionar"
        app:iconPadding="4dp"
        app:iconSize="16dp"
        app:iconTint="@color/branco"
        app:layout_constraintBottom_toBottomOf="@id/tituloSolicitacoes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tituloSolicitacoes" />

    <EditText
        android:id="@+id/campoBuscaSolicitacao"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:autofillHints="name"
        android:background="@drawable/fundo_campo_busca"
        android:drawableStart="@drawable/ic_busca"
        android:drawablePadding="10dp"
        android:fontFamily="@font/nunito_regular"
        android:hint="@string/buscar_unidade"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/verde_escuro_principal"
        android:textColorHint="@color/cinza_texto_auxiliar"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloSolicitacoes" />

    <HorizontalScrollView
        android:id="@+id/rolagemFiltros"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/campoBuscaSolicitacao">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/filtrosSolicitacoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />

    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/atualizacaoSolicitacoes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="72dp"
        app:layout_constraintBottom_toBottomOf="@id/barraNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rolagemFiltros">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaSolicitacoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/textoEstadoSolicitacoes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:fontFamily="@font/nunito_regular"
        android:gravity="center"
        android:textColor="@color/cinza_texto_auxiliar"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/atualizacaoSolicitacoes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/atualizacaoSolicitacoes"
        app:layout_constraintVertical_bias="0.4" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoAcaoEstadoSolicitacoes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        app:backgroundTint="@color/verde_escuro_principal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoEstadoSolicitacoes" />

    <ProgressBar
        android:id="@+id/indicadorSolicitacoes"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:indeterminateTint="@color/verde_escuro_principal"
        app:layout_constraintBottom_toBottomOf="@id/atualizacaoSolicitacoes"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/atualizacaoSolicitacoes" />

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
