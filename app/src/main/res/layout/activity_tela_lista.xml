<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizTelaLista"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".views.TelaListaActivity">

    <ImageView
        android:id="@+id/botaoVoltarTelaLista"
        style="@style/BotaoVoltar"
        android:contentDescription="@string/voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tituloTelaLista"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="26dp"
        android:fontFamily="@font/nunito_bold"
        android:textColor="@color/rosa_ecociente"
        android:textSize="22sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/botaoVoltarTelaLista" />

    <ImageView
        android:id="@+id/botaoSalvosTelaLista"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/ver_salvos"
        android:padding="10dp"
        android:src="@drawable/ic_marcador"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tituloTelaLista"
        app:layout_constraintEnd_toStartOf="@id/botaoFiltrarTelaLista"
        app:layout_constraintTop_toTopOf="@id/tituloTelaLista" />

    <ImageView
        android:id="@+id/botaoFiltrarTelaLista"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/filtrar_conteudos"
        android:padding="10dp"
        android:src="@drawable/ic_filtrar"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/tituloTelaLista"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tituloTelaLista" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="@dimen/espaco_barra_navegacao"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="@id/barraNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tituloTelaLista">

        <LinearLayout
            android:id="@+id/listaItens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </androidx.core.widget.NestedScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
