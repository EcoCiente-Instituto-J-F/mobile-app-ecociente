<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizQuizResultado"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- A tela não rola. Somente a lista dentro do card central possui rolagem. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/conteudoQuizResultado"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <FrameLayout
            android:id="@+id/cabecalhoResultadoQuiz"
            android:layout_width="0dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/botaoVoltarResultadoQuiz"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quiz_resultado_voltar"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_voltar"
                app:tint="@color/verde_escuro_principal" />

            <TextView
                android:id="@+id/textoTituloResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/nunito_regular"
                android:includeFontPadding="false"
                android:text="@string/quiz_sua_pontuacao"
                android:textColor="#565656"
                android:textSize="26sp" />

        </FrameLayout>

        <TextView
            android:id="@+id/textoPontuacaoResultado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/nunito_regular"
            android:includeFontPadding="false"
            android:text="07/10"
            android:textColor="#565656"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cabecalhoResultadoQuiz" />

        <TextView
            android:id="@+id/textoMensagemResultado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            android:fontFamily="@font/nunito_semibold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:maxLines="3"
            android:text="@string/quiz_resultado_mensagem_boa"
            android:textAlignment="center"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoPontuacaoResultado" />

        <LinearLayout
            android:id="@+id/cardResumoResultado"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/fundo_card_pergunta_quiz"
            android:elevation="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="20dp"
            android:paddingEnd="26dp"
            android:paddingBottom="18dp"
            app:layout_constraintBottom_toTopOf="@id/botaoFinalizarResultadoQuiz"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textoMensagemResultado">

            <TextView
                android:id="@+id/textoCategoriaResultado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/nunito_regular"
                android:includeFontPadding="false"
                android:text="@string/inicio_quiz_titulo_padrao"
                android:textColor="#A1A1A1"
                android:textSize="18sp" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/rolagemListaResultado"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="18dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:fillViewport="false"
                android:overScrollMode="always">

                <LinearLayout
                    android:id="@+id/listaResultadoPerguntas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp" />

            </androidx.core.widget.NestedScrollView>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoFinalizarResultadoQuiz"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="12dp"
            android:elevation="4dp"
            android:fontFamily="@font/nunito_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/quiz_finalizar"
            android:textAllCaps="false"
            android:textColor="@color/branco"
            android:textSize="19sp"
            app:backgroundTint="@color/verde_escuro_principal"
            app:cornerRadius="16dp"
            app:layout_constraintBottom_toTopOf="@id/botaoRepetirResultadoQuiz"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botaoRepetirResultadoQuiz"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="@font/nunito_semibold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/quiz_repetir"
            android:textAllCaps="false"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="19sp"
            app:backgroundTint="@color/branco"
            app:cornerRadius="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeColor="@color/verde_escuro_principal"
            app:strokeWidth="1.5dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.example.ecociente.views.ConfettiView
        android:id="@+id/confettiResultadoQuiz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:visibility="gone" />

</FrameLayout>
