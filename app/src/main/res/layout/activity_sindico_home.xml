<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raizSindicoHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:contentDescription="@string/logo_ecociente"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_ecociente"
            app:tint="@color/verde_escuro_principal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/botaoMensagensSindico"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/mensagens"
                android:focusable="true">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat_bolha" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/botaoAvisosSindico"
                android:layout_width="34dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/sindico_abrir_avisos"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/icon_notificacoes" />
                <View
                    android:id="@+id/pontoAvisosSindico"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/sindico_ponto_novo"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/botaoPerfilSindico"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:contentDescription="@string/sindico_perfil_do_sindico"
                android:focusable="true"
                app:cardBackgroundColor="@color/cinza_fundo_imagem_home"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/imagemPerfilSindico"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/foto_perfil"
                    android:padding="5dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_perfil_usuario" />

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="11dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/sindicoSaudacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_bold"
                        android:text="@string/sindico_saudacao_demo"
                        android:textColor="@color/rosa_ecociente"
                        android:textSize="22sp" />
                    <TextView
                        android:id="@+id/sindicoCondominio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/nunito_regular"
                        android:text="@string/sindico_condominio_demo"
                        android:textColor="@color/cinza_texto_home"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="83dp"
                    android:layout_height="82dp"
                    android:contentDescription="@string/sindico_ilustracao_de_reciclagem"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sindico_reciclagem" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_cartao_borda"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/sindico_calendario" />
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/nunito_bold"
                        android:text="@string/calendario_da_semana"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/linkCalendarioCompleto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/nunito_semibold"
                        android:padding="4dp"
                        android:text="@string/sindico_ver_calendario_completo"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.example.ecociente.ui.SemanaColetasView
                    android:id="@+id/semanaColetas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/textoErroSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/nunito_regular"
                    android:gravity="center"
                    android:text="@string/semana_erro"
                    android:textColor="@color/cinza_texto_auxiliar"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sindicoDashboardResumo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/fundo_cartao_borda"
                android:clickable="true"
                android:contentDescription="@string/sindico_abrir_dashboard_de_desempenho_comp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/sindico_tendencia" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/nunito_semibold"
                        android:text="@string/sindico_dashboard_de_desempenho"
                        android:textColor="@color/verde_escuro_principal"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sindicoMetricas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <com.example.ecociente.views.SindicoGraficoView
                    android:id="@+id/sindicoGrafico"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="14dp"
                    android:contentDescription="@string/sindico_evolucao_ilustrativa_dos_descartes" />
            </LinearLayout>

            <TextView
                android:id="@+id/sindicoRankingTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="7dp"
                android:clickable="true"
                android:contentDescription="@string/sindico_abrir_ranking_completo"
                android:focusable="true"
                android:fontFamily="@font/nunito_bold"
                android:text="@string/sindico_detalhes_do_ranking"
                android:textColor="@color/verde_escuro_principal"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/sindicoRanking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/sindico_card_destaque"
                android:clickable="true"
                android:contentDescription="@string/sindico_abrir_ranking_completo"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="10dp" />
        </LinearLayout>
    </ScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraInferiorSindico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
