<?xml version="1.0" encoding="utf-8"?>

<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/botaoMesAnterior"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/mes_anterior"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:text="@string/simbolo_voltar"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textoMesCalendario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/nunito_semibold"
            android:textColor="@color/rosa_ecociente"
            android:textSize="15sp"
            android:minWidth="130dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/botaoProximoMes"
            android:layout_width="40dp"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/proximo_mes"
            android:fontFamily="@font/nunito_bold"
            android:gravity="center"
            android:text="@string/simbolo_avancar"
            android:textColor="@color/verde_escuro_principal"
            android:textSize="24sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linhaDiasSemana"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

    <LinearLayout
        android:id="@+id/gradeDiasCalendario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/cinza_borda_clara_home" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="14dp"
            android:layout_height="12dp"
            android:background="@drawable/fundo_marca_coleta" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/nunito_regular"
            android:text="@string/dia_de_coleta"
            android:textColor="@color/cinza_texto_home"
            android:textSize="11sp" />

    </LinearLayout>

</merge>
