<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizHomeCooperativa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".views.CooperativaHomeActivity">

    <FrameLayout
        android:id="@+id/cabecalhoHomeCooperativa"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="136dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/logo_ecociente"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_ecociente"
            app:tint="@color/verde_escuro_principal" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            app:cardBackgroundColor="@color/cinza_fundo_imagem_home"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imagemPerfilCooperativa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/foto_perfil"
                android:padding="5dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_perfil_usuario" />

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

    <TextView
        android:id="@+id/textoSaudacaoCooperativa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/nunito_bold"
        android:textColor="@color/rosa_ecociente"
        android:textSize="22sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cabecalhoHomeCooperativa"
        tools:text="Olá, Julio!" />

    <TextView
        android:id="@+id/textoNomeCooperativa"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="26dp"
        android:fontFamily="@font/nunito_regular"
        android:textColor="@color/cinza_texto_home"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoSaudacaoCooperativa"
        tools:text="Cooperativa Recicla Mais" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rolagemHomeCooperativa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="72dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="@id/barraNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoNomeCooperativa">

        <LinearLayout
            android:id="@+id/conteudoHomeCooperativa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <com.example.ecociente.ui.ProximaColetaView
                android:id="@+id/cardProximaColeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/cardCalendarioColetas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/fundo_card_calendario"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/nunito_bold"
                    android:text="@string/calendario_de_coletas"
                    android:textColor="@color/branco"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/nunito_regular"
                    android:text="@string/acompanhe_suas_coletas"
                    android:textColor="@color/branco"
                    android:textSize="11sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/branco"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/cinza_borda_clara_home"
                    app:strokeWidth="1dp">

                    <com.example.ecociente.ui.CalendarioMensalView
                        android:id="@+id/calendarioMensal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/branco"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cinza_borda_clara_home"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/atalhoAvisos"
                        style="@style/LinhaAtalho"
                        android:text="@string/avisos" />

                    <TextView
                        android:id="@+id/atalhoNovaColeta"
                        style="@style/LinhaAtalho"
                        android:text="@string/nova_coleta" />

                    <TextView
                        android:id="@+id/atalhoCondominios"
                        style="@style/LinhaAtalho"
                        android:text="@string/condominios_atendidos" />

                    <TextView
                        android:id="@+id/atalhoAvaliacoes"
                        style="@style/LinhaAtalho"
                        android:text="@string/avaliacoes_recebidas" />

                    <TextView
                        android:id="@+id/atalhoNotificacoes"
                        style="@style/LinhaAtalho"
                        android:text="@string/gerenciar_notificacoes" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.example.ecociente.ui.BarraNavegacaoView
        android:id="@+id/barraNavegacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
