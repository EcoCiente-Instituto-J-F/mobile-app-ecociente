<?xml version="1.0" encoding="utf-8"?>

<!--
    Nada do app sai do aparelho: o token e as credenciais ficam cifradas no Keystore e não
    fazem sentido em outro aparelho, e o banco e as preferências guardam dados da conta.
    Vale para o backup na nuvem e para a transferência entre aparelhos (Android 12 ou mais).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
